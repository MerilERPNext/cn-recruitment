    },
    {
      "name": "tbrkk69514",
      "owner": "Administrator",
      "modified": "2024-09-18 11:57:29.663767",
      "modified_by": "Administrator",
      "docstatus": 0,
      "idx": 2,
      "data": "{\"node_label\":\"Generate Hiring Url\",\"python_code\":\"doc = variables.get(\\\"doc\\\")\\nsite_url=frappe.utils.get_url()\\nurl=site_url+\\\"/app/job-applicant/\\\"+doc.name\\nhiring_manager_name=frappe.db.get_value(\\\"User\\\", doc.owner, \\\"full_name\\\")\\nhr_heads = frappe.db.sql(\\\"\\\"\\\"\\nSELECT user.name, user.full_name\\nFROM `tabUser` user\\nJOIN `tabHas Role` has_role ON has_role.parent = user.name\\nWHERE has_role.role = %s\\n\\\"\\\"\\\", (\\\"Recruiter Admin\\\",), as_dict=True)\\nfiltered_hr_heads = [item for item in hr_heads if item['name'] != 'Administrator']\\nmails = ','.join([item['name'] for item in filtered_hr_heads])\\nvariables[\\\"url\\\"]=url\\nvariables[\\\"recruiter_head_mails\\\"]=mails\\nvariables[\\\"hiring_manager_name\\\"]=hiring_manager_name\",\"skip_queue_and_execute_immediately\":true,\"execute_current_node_as_user\":\"\",\"submit\":true,\"variable_path_for_output\":\"\"}",
