\\\", \\\"width\\\": \\\"\\\", \\\"height\\\": \\\"\\\"},\\n            \\\"type\\\": \\\"file\\\",\\n            \\\"imageSize\\\": \\\"200\\\",\\n            \\\"capture\\\": False,\\n            \\\"input\\\": True,\\n            \\\"placeholder\\\": \\\"\\\",\\n            \\\"prefix\\\": \\\"\\\",\\n            \\\"suffix\\\": \\\"\\\",\\n            \\\"defaultValue\\\": None,\\n            \\\"unique\\\": False,\\n            \\\"refreshOn\\\": \\\"\\\",\\n            \\\"dataGridLabel\\\": False,\\n            \\\"widget\\\": None,\\n            \\\"validateOn\\\": \\\"change\\\",\\n            \\\"showCharCount\\\": False,\\n            \\\"showWordCount\\\": False,\\n            \\\"allowMultipleMasks\\\": False,\\n            \\\"privateDownload\\\": False\\n        }\\n\\n        # Add to the first available tab\\n        for tab in tabs:\\n            if len(tab[\\\"components\\\"]) < 5:\\n                tab[\\\"components\\\"].append(file_component)\\n                break\\n\\n# Remove empty tabs\\ntabs = [tab for tab in tabs if tab[\\\"components\\\"]]\\n\\n# Add tabs to the panel if any tab has components\\nif tabs:\\n    panel_component[\\\"components\\\"].append({\\n        \\\"label\\\": \\\"Tabs\\\",\\n        \\\"key\\\": \\\"tabs\\\",\\n        \\\"type\\\": \\\"tabs\\\",\\n        \\\"components\\\": tabs\\n    })\\n\\n# Final JSON Structure\\nform_io_json = {\\n    \\\"components\\\": [panel_component] if tabs else []\\n}\\n\\n# Add Submit Button\\nform_io_json[\\\"components\\\"].append({\\n    \\\"type\\\": \\\"button\\\",\\n    \\\"label\\\": \\\"Submit\\\",\\n    \\\"key\\\": \\\"submit\\\",\\n    \\\"size\\\": \\\"md\\\",\\n    \\\"block\\\": False,\\n    \\\"action\\\": \\\"submit\\\",\\n    \\\"disableOnInvalid\\\": True,\\n    \\\"theme\\\": \\\"primary\\\",\\n    \\\"input\\\": True\\n})\\n\\n# Store JSON in variables[\\\"form_io_json\\\"]\\nvariables[\\\"form_io_json\\\"] = json.dumps(form_io_json)\\n\\n\\nvariables[\\\"doc_name\\