       "data": "{\"node_label\":\"Dict to Str\",\"python_code\":\"variables[\\\"doc_json\\\"] = json.dumps(variables[\\\"doc_data\\\"], default=str)\\ndoc_data = variables[\\\"doc_data\\\"]\\nchild_table = doc_data.get(\\\"custom_documents_for_verification\\\", [])\\n\\n# Add the panel\\npanel_component = {\\n    \\\"title\\\": \\\"Rejected Documents Re-Submission\\\",\\n    \\\"theme\\\": \\\"default\\\",\\n    \\\"tooltip\\\": \\\"\\\",\\n    \\\"customClass\\\": \\\"\\\",\\n    \\\"collapsible\\\": False,\\n    \\\"hidden\\\": False,\\n    \\\"hideLabel\\\": False,\\n    \\\"disabled\\\": False,\\n    \\\"modalEdit\\\": False,\\n    \\\"key\\\": \\\"rejectedDocumentsReSubmission\\\",\\n    \\\"tags\\\": [],\\n    \\\"properties\\\": {},\\n    \\\"type\\\": \\\"panel\\\",\\n    \\\"label\\\": \\\"Panel\\\",\\n    \\\"breadcrumb\\\": \\\"default\\\",\\n    \\\"tabindex\\\": \\\"\\\",\\n    \\\"input\\\": False,\\n    \\\"components\\\": []\\n}\\n\\n# Tabs Initialization\\ntabs = [\\n    {\\\"label\\\": \\\"Tab 1\\\", \\\"key\\\": \\\"tab1\\\", \\\"components\\\": []},\\n    {\\\"label\\\": \\\"Tab 2\\\", \\\"key\\\": \\\"tab2\\\", \\\"components\\\": []},\\n    {\\\"label\\\": \\\"Tab 3\\\", \\\"key\\\": \\\"tab3\\\", \\\"components\\\": []}\\n]\\n\\n# Add Rejected Documents to Components\\nfor row in child_table:\\n    if row.get(\\\"status\\\") == \\\"Rejected\\\":\\n        fieldname = row.get(\\\"fieldname\\\")  # Fetching actual fieldname from the child table\\n        document_label = row.get(\\\"document\\\")\\n\\n        file_component = {\\n            \\\"label\\\": document_label,\\n            \\\"labelPosition\\\": \\\"top\\\",\\n            \\\"description\\\": \\\"\\\",\\n            \\\"tooltip\\\": \\\"\\\",\\n            \\\"customClass\\\": \\\"\\\",\\n            \\\"tabindex\\\": \\\"\\\",\\n            \\\"hidden\\\": False,\\n            \\\"hideLabel\\\": False,\\n            \\\"autofocus\\\": False,\\n            \\\"disabled\\\": False,\\