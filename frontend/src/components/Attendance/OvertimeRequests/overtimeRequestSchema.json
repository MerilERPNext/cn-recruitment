{
  "title": "Planned Overtime Request",
  "name": "plannedOvertimeRequest",
  "path": "planned-overtime-request",
  "display": "form",
  "components": [
    {
      "type": "hidden",
      "key": "show_attachment",
      "input": true
    },
    {
      "type": "datagrid",
      "key": "overtime_details",
      "label": "Overtime Requests",
      "errorLabel": "Overtime Requests",
      "addAnother": "New Row",
      "customClass": "border-0",
      "components": [
        {
          "type": "datetime",
          "key": "start_date",
          "label": "Start Date",
          "errorLabel": "Start Date",
          "format": "dd-MM-yyyy",
          "enableTime": false,
         
          "input": true
        },
        {
          "type": "datetime",
          "key": "start_time",
          "label": "Start Time",
          "errorLabel": "Start Time",
          "enableDate": false,
          "enableTime": true,
          "input": true,
          "widget": { "type": "calendar" },
          "validate": { "required": true }
        },
        {
          "type": "datetime",
          "key": "end_date",
          "label": "End Date",
          "errorLabel": "End Date",
          "format": "dd-MM-yyyy",
          "enableTime": false,
         
          "input": true
        },
        {
          "type": "datetime",
          "key": "end_time",
          "label": "End Time",
          "errorLabel": "End Time",
          "enableDate": false,
          "enableTime": true,
          "input": true,
          "widget": { "type": "calendar" },
          "validate": { "required": true }
        },
        {
          "type": "textfield",
          "key": "message",
          "label": "Message",
          "errorLabel": "Message",
         
          "input": true
        }
      ]
    },

    {
      "type": "file",
      "key": "attachment",
      "label": "Attachment",
      "input": true,
      "multiple": true,
      "storage": "customfiles",
      "fileReader": false,
      "privateDownload": false,
      "conditional": {
        "show": true,
        "when": "show_attachment",
        "eq": true
      }
    }
  ]
}
