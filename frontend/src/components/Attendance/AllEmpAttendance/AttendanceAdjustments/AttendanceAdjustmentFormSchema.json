{
    "title": "Attendance Adjustments",
    "name": "attendanceAdjustments",
    "path": "attendance-adjustments",
    "display": "form",
    "components": [
        {
            "type": "datagrid",
            "key": "attendance_adjustment_details",
            "label": "",
            "errorLabel": "Attendance Adjustments",
            "addAnother": "New Row",
            "customClass": "border-0",
            "components": [
                {
                    "type": "datetime",
                    "key": "start_date",
                    "label": "Start Date",
                    "errorLabel": "Start Date",
                    "format": "dd-MM-yyyy",
                    "enableTime": false,
                    "input": true
                },
                {
                    "type": "datetime",
                    "key": "end_date",
                    "label": "End Date",
                    "errorLabel": "End Date",
                    "format": "dd-MM-yyyy",
                    "enableTime": false,
                    "input": true
                },
                {
                    "type": "datetime",
                    "key": "check_in",
                    "label": "Check In",
                    "errorLabel": "Check In",
                    "enableDate": false,
                    "enableTime": true,
                    "input": true,
                    "widget": {
                        "type": "calendar",
                        "showMeridian": false
                    },
                    "timePicker": {
                        "showMeridian": false
                    },
                    "validate": {
                        "required": true
                    }
                },
                {
                    "type": "datetime",
                    "key": "check_out",
                    "label": "Check Out",
                    "errorLabel": "Check Out",
                    "enableDate": false,
                    "enableTime": true,
                    "input": true,
                    "widget": {
                        "type": "calendar",
                        "showMeridian": false
                    },
                    "timePicker": {
                        "showMeridian": false
                    },
                    "validate": {
                        "required": true
                    }
                },
                {
                    "label": "Reason",
                    "key": "custom__request_reason",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select a reason",
                    "customClass": "mb-4",
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/resource/Reason?fields=[\"name\",\"reason\",\"reason_type\"]&filters=[[\"reference_doctype\",\"=\",\"Attendance Request\"]]"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.reason }}</span>",
                    "selectValues": "data",
                    "refreshOn": "request_type",
                    "clearOnRefresh": true,
                    "lazyLoad": false
                },
                {
                    "label": "Location <span class='show-req-astrik field-required'></span>",
                    "errorLabel": "Location",
                    "key": "custom_location",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select a location",
                    "customClass": "mb-4",
                    "data": {
                        "values": [
                            {
                                "label": "Office",
                                "value": "Office"
                            },
                            {
                                "label": "Home",
                                "value": "Home"
                            },
                            {
                                "label": "Field Duty",
                                "value": "Field Duty"
                            }
                        ]
                    }
                },
                {
                    "type": "textfield",
                    "key": "message",
                    "label": "Message",
                    "errorLabel": "Message",
                    "input": true
                }
            ]
        }
    ]
}