{
  "title": "Attendance Request",
  "name": "attendanceRequest",
  "path": "attendance-request",
  "display": "form",
  "components": [
    {
      "type": "panel",
      "key": "attendanceRequestPanel",
      "label": "Attendance Request",
      "title": "Attendance Request",
      "hideLabel": true,
      "customClass": "bg-white rounded-lg show-req-astrik  ",
      "components": [
        {
          "type": "hidden",
          "key": "show_attachment",
          "input": false
        },
        {
          "type": "hidden",
          "key": "allowed_from_date",
          "input": true
        },
        {
          "type": "hidden",
          "key": "allowed_to_date",
          "input": true
        },
        {
          "type": "hidden",
          "key": "isForOthers",
          "input": true,
          "defaultValue": false
        },
        {
          "type": "hidden",
          "key": "currentEmployeeId",
          "input": true,
          "defaultValue": ""
        },
        {
          "type": "hidden",
          "key": "currentUserId",
          "input": true,
          "defaultValue": ""
        },
        {
          "label": "Employee",
          "errorLabel": "Employee",
          "key": "employee",
          "type": "select",
          "input": true,
          "placeholder": "Select Employee",
          "customClass": "mb-4",
          "customConditional": "show = data.isForOthers === true;",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/cn_leave_shift_managment.api.get_reportees"
          },
          "valueProperty": "",
          "logic": [
            {
              "name": "update company",
              "trigger": {
                "type": "event",
                "event": "change"
              },
              "actions": [
                {
                  "name": "company action",
                  "type": "customAction",
                  "customAction": "const company = instance.root.getComponent('company'); if (company && instance.dataValue) { company.setValue(instance.dataValue.company, { fromLogic: true }); }"
                }
              ]
            }
          ],
          "template": "<span>{{ item.employee_name }} ({{ item.name }})</span>",
          "selectValues": "message",
          "refreshOn": "isForOthers",
          "clearOnRefresh": false,
          "lazyLoad": false
        },
        {
          "label": "Company",
          "key": "company",
          "type": "textfield",
          "placeholder": "Company",
          "input": true,
          "customClass": "mb-4",
          "disabled": true,
          "errorLabel": "Company",
          "customConditional": "show = data.isForOthers === true;",
          "customDefaultValue": " ",
          "calculateValue": " ",
          "allowCalculateOverride": true,
          "applyMaskOn": "change"
        },
        {
          "label": "Request Type",
          "errorLabel": "Request Type",
          "key": "request_type",
          "type": "select",
          "input": true,
          "placeholder": "Select a Request Type",
          "defaultValue": "Attendance Adjustment",
          "customClass": "mb-4",
          "validate": {
            "required": true
          },
          "data": {
            "values": [
              {
                "label": "Clockin Request",
                "value": "Clockin"
              },
              {
                "label": "Out Duty Request",
                "value": "Out Duty"
              },
              {
                "label": "Short Attendance Request",
                "value": "Short Attendance Request"
              },
              {
                "label": "Attendance Adjustment",
                "value": "Attendance Adjustment"
              }
            ]
          }
        },
        {
          "label": "From Date",
          "errorLabel": "From Date",
          "key": "from_date",
          "type": "datetime",
          "input": true,
          "enableMinDateInput": false,
          "enableMaxDateInput": false,
          "validateWhenHidden": false,
          "widget": {
            "type": "calendar",
            "minDate": "allowed_from_date",
            "maxDate": "allowed_to_date"
          },
          "datePicker": {
            "minDate": "allowed_from_date",
            "maxDate": "allowed_to_date"
          },
          "format": "dd-MM-yyyy",
          "placeholder": "dd-mm-yyyy",
          "customClass": "mb-4",
          "enableTime": false,
          "validate": {},
          "disabled": false,
          "redrawOn": "allowed_from_date"
        },
        {
          "label": "To Date",
          "errorLabel": "To Date",
          "key": "to_date",
          "type": "datetime",
          "input": true,
          "widget": {
            "type": "calendar",
            "minDate": "from_date",
            "maxDate": "allowed_to_date"
          },
          "datePicker": {
            "minDate": "from_date",
            "maxDate": "allowed_to_date"
          },
          "format": "dd-MM-yyyy",
          "placeholder": "dd-mm-yyyy",
          "customClass": "mb-4",
          "enableTime": false,
          "validate": {
            "custom": "valid = !data.from_date || !input || new Date(input) >= new Date(data.from_date);",
            "customMessage": "To Date cannot be earlier than From Date"
          },
          "customConditional": "show = !['Clockin'].includes(data.request_type || '');",
          "calculateValue": "value = (data.request_type === 'Short Attendance Request' && !value) ? data.from_date : value",
          "disabled": false,
          "redrawOn": "from_date"
        },
        {
          "label": "Check-In Time <span class='show-req-astrik field-required'></span>",
          "key": "checkin_time",
          "type": "time",
          "input": true,
          "allowCalculateOverride": true,
          "validate": {
            "customMessage": "From Time is required",
            "custom": "valid = ['Clockin', 'Short Attendance Request', 'Attendance Adjustment'].includes(data.request_type) ? !!input : true;"
          },
          "customConditional": "show = ['Attendance Adjustment', 'Short Attendance Request', 'Clockin'].includes(data.request_type || '');",
          "enableDate": false,
          "enableTime": true,
          "format": "HH:mm",
          "placeholder": "HH:mm",
          "widget": {
            "type": "input"
          },
          "customClass": "mb-4"
        },
        {
          "label": "Check-Out Time <span class='show-req-astrik field-required'></span>",
          "errorLabel": "To Time",
          "key": "checkout_time",
          "type": "time",
          "allowCalculateOverride": true,
          "input": true,
          "enableDate": false,
          "enableTime": true,
          "format": "HH:mm",
          "placeholder": "HH:mm",
          "customClass": "mb-4",
          "validate": {
            "customMessage": "To Time is required",
            "custom": "valid = ['Short Attendance Request', 'On Duty', 'Attendance Adjustment'].includes(data.request_type) ? !!input : true;"
          },
          "customConditional": "show = ['Attendance Adjustment', 'Short Attendance Request'].includes(data.request_type || '');",
          "widget": {
            "type": "input"
          }
        },
        {
          "label": "Select Shift",
          "key": "select_shift",
          "type": "select",
          "input": true,
          "placeholder": "Select shift",
          "customClass": "mb-4",
          "customConditional": "show = data.request_type === 'Shift Change';",
          "dataSrc": "url",
          "data": {
            "url": "/api/resource/Shift Type"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.name }}</span>",
          "selectValues": "data",
          "lazyLoad": false
        },
        {
          "label": "Reason",
          "key": "custom__request_reason",
          "type": "select",
          "input": true,
          "placeholder": "Select a reason",
          "customClass": "mb-4",
          "customConditional": "show = !['Shift Change','Out Duty'].includes(data.request_type);",
          "dataSrc": "url",
          "data": {
            "url": "/api/resource/Reason?fields=[\"name\",\"reason\",\"reason_type\"]&filters=[[\"reference_doctype\",\"=\",\"Attendance Request\"]]"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.reason }}</span>",
          "selectValues": "data",
          "refreshOn": "request_type",
          "clearOnRefresh": true,
          "lazyLoad": false
        },
        {
          "label": "Location <span class='show-req-astrik field-required'></span>",
          "errorLabel": "Location",
          "key": "custom_location",
          "type": "select",
          "input": true,
          "placeholder": "Select a location",
          "customClass": "mb-4",
          "customConditional": "show = ['Clockin', 'Attendance Adjustment'].includes(data.request_type || '');",
          "validate": {
            "customMessage": "Location is required",
            "custom": "valid = ['Clockin', 'Attendance Adjustment'].includes(data.request_type) ? !!input : true;"
          },
          "data": {
            "values": [
              {
                "label": "Office",
                "value": "Office"
              },
              {
                "label": "Home",
                "value": "Home"
              },
              {
                "label": "Field Duty",
                "value": "Field Duty"
              }
            ]
          }
        },
        {
          "label": "Message",
          "key": "explanation",
          "type": "textarea",
          "input": true,
          "placeholder": "Provide additional details...",
          "rows": 4,
          "customClass": "mb-4"
        },
        {
          "label": "Attachments",
          "key": "attachments",
          "type": "file",
          "input": true,
          "multiple": true,
          "size": "false",
          "storage": "customfiles",
          "fileReader": false,
          "privateDownload": false,
          "filePattern": ".pdf,.doc,.docx,.xls,.xlsx,.csv,.jpg,.jpeg,.png",
          "tooltip": "Upload receipts or supporting documents.",
          "conditional": {
            "show": true,
            "when": "show_attachment",
            "eq": true
          }
        }
      ]
    }
  ]
}