{
  "title": "Attendance Request",
  "name": "attendanceRequest",
  "path": "attendance-request",
  "display": "form",
  "components": [
    {
      "type": "panel",
      "key": "attendanceRequestPanel",
      "label": "Attendance Request",
      "title": "Attendance Request",
      "hideLabel": true,
      "customClass": "bg-white rounded-lg",
      "components": [
        {
          "type": "hidden",
          "key": "show_attachment",
          "input": false
        },
        {
          "type": "hidden",
          "key": "allowed_from_date",
          "input": true
        },
        {
          "type": "hidden",
          "key": "allowed_to_date",
          "input": true
        },
        {
          "type": "hidden",
          "key": "isForOthers",
          "input": true,
          "defaultValue": false
        },
        {
          "type": "hidden",
          "key": "currentEmployeeId",
          "input": true,
          "defaultValue": ""
        },
        {
          "type": "hidden",
          "key": "currentUserId",
          "input": true,
          "defaultValue": ""
        },
        {
          "label": "Employee",
          "errorLabel": "Employee",
          "key": "employee",
          "type": "select",
          "input": true,
          "placeholder": "Select Employee",
          "customClass": "mb-4",
          "customConditional": "show = data.isForOthers === true;",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/cn_leave_shift_managment.api.get_reportees"
          },
          "valueProperty": "",
          "logic": [
            {
              "name": "update company",
              "trigger": {
                "type": "event",
                "event": "change"
              },
              "actions": [
                {
                  "name": "company action",
                  "type": "customAction",
                  "customAction": "const company = instance.root.getComponent('company'); if (company && instance.dataValue) { company.setValue(instance.dataValue.company, { fromLogic: true }); }"
                }
              ]
            }
          ],
          "template": "<span>{{ item.employee_name }} ({{ item.name }})</span>",
          "selectValues": "message",
          "refreshOn": "isForOthers",
          "clearOnRefresh": false,
          "lazyLoad": false
        },
        {
          "label": "Company",
          "key": "company",
          "type": "textfield",
          "placeholder": "Company",
          "input": true,
          "customClass": "mb-4",
          "disabled": true,
          "errorLabel": "Company",
          "customConditional": "show = data.isForOthers === true;",
          "customDefaultValue": " ",
          "calculateValue": " ",
          "allowCalculateOverride": true,
          "applyMaskOn": "change"
        },
        {
          "label": "Request Type <span style='color:red;margin-left:3px;'> *</span>",
          "errorLabel": "Request Type",
          "key": "request_type",
          "type": "select",
          "input": true,
          "placeholder": "Select a Request Type",
          "customClass": "mb-4",
          "validate": {
            "required": true
          },
          "data": {
            "values": [
              {
                "label": "Clockin Request",
                "value": "Clockin"
              },
              {
                "label": "Out Duty Request",
                "value": "Out Duty"
              },
              {
                "label": "Short Attendance Request",
                "value": "Short Attendance Request"
              },
              {
                "label": "Attendance Adjustment",
                "value": "Attendance Adjustment"
              }
            ]
          }
        },
        {
          "type": "columns",
          "key": "dateColumns",
          "columns": [
            {
              "width": 6,
              "components": [
                {
                  "type": "select",
                  "key": "shift_start",
                  "label": "Shift Start",
                  "placeholder": "Loading shift information...",
                  "input": true,
                  "defaultValue": "Not Assigned",
                  "customClass": "mb-4",
                  "disabled": true,
                  "hidden": false,
                  "widget": "choicesjs",
                  "dataSrc": "url",
                  "data": {
                    "url": "/api/method/cn_leave_shift_managment.api.get_employee_shift?user={{data.currentUserId}}"
                  },
                  "valueProperty": "start_time",
                  "template": "<span>{{ item.start_time }}</span>",
                  "selectValues": "message",
                  "refreshOn": "currentUserId",
                  "clearOnRefresh": true,
                  "lazyLoad": true,
                  "logic": [
                    {
                      "name": "update shift  start time",
                      "trigger": {
                        "type": "event",
                        "event": "change"
                      },
                      "actions": [
                        {
                          "name": "company action",
                          "type": "customAction",
                          "customAction": "if (instance?.defaultDownloadedResources?.start_time) { instance.setValue(instance?.defaultDownloadedResources?.start_time); }"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "width": 6,
              "components": [
                {
                  "type": "select",
                  "key": "shift_end",
                  "label": "Shift End",
                  "placeholder": "Loading shift information...",
                  "defaultValue": "Not Assigned",
                  "input": true,
                  "customClass": "mb-4",
                  "disabled": true,
                  "hidden": false,
                  "widget": "choicesjs",
                  "dataSrc": "url",
                  "data": {
                    "url": "/api/method/cn_leave_shift_managment.api.get_employee_shift?user={{data.currentUserId}}"
                  },
                  "valueProperty": "end_time",
                  "template": "<span>{{ item.end_time }}</span>",
                  "selectValues": "message",
                  "refreshOn": "currentUserId",
                  "clearOnRefresh": true,
                  "lazyLoad": true,
                  "logic": [
                    {
                      "name": "update shift  end time",
                      "trigger": {
                        "type": "event",
                        "event": "change"
                      },
                      "actions": [
                        {
                          "name": "company action",
                          "type": "customAction",
                          "customAction": "if (instance?.defaultDownloadedResources?.end_time) { instance.setValue(instance?.defaultDownloadedResources?.end_time); }"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "From Date",
          "errorLabel": "From Date",
          "key": "from_date",
          "type": "datetime",
          "input": true,
          "enableMinDateInput": false,
          "enableMaxDateInput": false,
          "validateWhenHidden": false,
          "widget": {
            "type": "calendar",
            "minDate": "allowed_from_date",
            "maxDate": "allowed_to_date"
          },
          "datePicker": {
            "minDate": "allowed_from_date",
            "maxDate": "allowed_to_date"
          },
          "format": "dd-MM-yyyy",
          "placeholder": "dd-mm-yyyy",
          "customClass": "mb-4",
          "enableTime": false,
          "validate": {},
          "disabled": false,
          "redrawOn": "allowed_from_date"
        },
        {
          "label": "To Date",
          "errorLabel": "To Date",
          "key": "to_date",
          "type": "datetime",
          "input": true,
          "widget": {
            "type": "calendar",
            "minDate": "allowed_from_date",
            "maxDate": "allowed_to_date"
          },
          "datePicker": {
            "minDate": "allowed_from_date",
            "maxDate": "allowed_to_date"
          },
          "format": "dd-MM-yyyy",
          "placeholder": "dd-mm-yyyy",
          "customClass": "mb-4",
          "enableTime": false,
          "validate": {},
          "customConditional": "show = !['Clockin','Out Duty'].includes(data.request_type || '');",
          "calculateValue": "value = data.request_type === 'Short Attendance Request' ? data.from_date : value",
          "disabled": false,
          "redrawOn": "from_date"
        },
        {
          "label": "From Time",
          "errorLabel": "From Time",
          "key": "custom_from_time",
          "type": "datetime",
          "input": true,
          "enableDate": false,
          "enableTime": true,
          "format": "HH:mm:ss",
          "placeholder": "hh:mm",
          "customClass": "mb-4",
          "validate": {
            "customMessage": "From Time is required",
            "custom": "valid = ['Clockin', 'Short Attendance Request', 'Attendance Adjustment'].includes(data.request_type) ? !!input : true;"
          },
          "customConditional": "show = ['Attendance Adjustment', 'Short Attendance Request', 'Clockin'].includes(data.request_type || '');",
          "widget": {
            "type": "calendar",
            "time_24hr": true,
            "noCalendar": true,
            "enableTime": true,
            "dateFormat": "H:i"
          }
        },
        {
          "label": "To Time <span style='color:red;margin-left:3px;'> *</span>",
          "errorLabel": "To Time",
          "key": "custom_to_time",
          "type": "datetime",
          "input": true,
          "enableDate": false,
          "enableTime": true,
          "format": "HH:mm:ss",
          "placeholder": "hh:mm",
          "customClass": "mb-4",
          "validate": {
            "customMessage": "To Time is required",
            "custom": "valid = ['Short Attendance Request', 'On Duty', 'Attendance Adjustment'].includes(data.request_type) ? !!input : true;"
          },
          "customConditional": "show = [ 'Attendance Adjustment', 'Short Attendance Request'].includes(data.request_type || '');",
          "widget": {
            "type": "calendar",
            "time_24hr": true,
            "noCalendar": true,
            "enableTime": true,
            "dateFormat": "H:i"
          }
        },
        {
          "type": "select",
          "key": "latest_checkin_time",
          "label": "Latest Check-In Time",
          "placeholder": "Loading shift information...",
          "defaultValue": "Not Assigned",
          "input": true,
          "disabled": true,
          "customConditional": "show = data.request_type === 'Attendance Adjustment';",
          "hidden": false,
          "widget": "choicesjs",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/cn_leave_shift_managment.api.get_shift_checkins?user={{data.currentUserId}}"
          },
          "valueProperty": "time",
          "template": "<span>{{ item.time }}</span>",
          "selectValues": "message",
          "refreshOn": "currentUserId",
          "clearOnRefresh": true,
          "lazyLoad": true,
          "logic": [
            {
              "name": "update check in time",
              "trigger": {
                "type": "event",
                "event": "change"
              },
              "actions": [
                {
                  "name": "company action",
                  "type": "customAction",
                  "customAction": "if ( instance?.defaultDownloadedResources && instance?.defaultDownloadedResources?.length>0) { instance.setValue(instance?.defaultDownloadedResources?.[0]?.time); }"
                }
              ]
            }
          ]
        },
        {
          "type": "select",
          "key": "latest_checkout_time",
          "label": "Latest Check-Out Time",
          "placeholder": "Loading Check-out information...",
          "defaultValue": "Not Assigned",
          "input": true,
          "disabled": true,
          "customConditional": "show = data.request_type === 'Attendance Adjustment';",
          "hidden": false,
          "widget": "choicesjs",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/cn_leave_shift_managment.api.get_shift_checkins?user={{data.currentUserId}}"
          },
          "valueProperty": "",
          "template": "<span>{{ item.time }}</span>",
          "selectValues": "message",
          "refreshOn": "currentUserId",
          "clearOnRefresh": true,
          "lazyLoad": false,
          "logic": [
            {
              "name": "update check out time",
              "trigger": {
                "type": "event",
                "event": "change"
              },
              "actions": [
                {
                  "name": "company action",
                  "type": "customAction",
                  "customAction": "if ( instance?.defaultDownloadedResources && instance?.defaultDownloadedResources?.length>0) {instance.setValue(instance?.defaultDownloadedResources?.[instance?.defaultDownloadedResources?.length - 1]?.time); }"
                }
              ]
            }
          ]
        },
        {
          "label": "Select Shift",
          "key": "select_shift",
          "type": "select",
          "input": true,
          "placeholder": "Select shift",
          "customClass": "mb-4",
          "customConditional": "show = data.request_type === 'Shift Change';",
          "dataSrc": "url",
          "data": {
            "url": "/api/resource/Shift Type"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.name }}</span>",
          "selectValues": "data",
          "lazyLoad": false
        },
        {
          "label": "Reason",
          "key": "custom__request_reason",
          "type": "select",
          "input": true,
          "placeholder": "Select a reason",
          "customClass": "mb-4",
          "customConditional": "show = !['Shift Change','Out Duty'].includes(data.request_type);",
          "dataSrc": "url",
          "data": {
            "url": "/api/resource/Reason?fields=[\"name\",\"reason\",\"reason_type\"]&filters=[[\"reference_doctype\",\"=\",\"Attendance Request\"]]"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.reason }}</span>",
          "selectValues": "data",
          "refreshOn": "request_type",
          "clearOnRefresh": true,
          "lazyLoad": false
        },
        {
          "label": "Location <span style='color:red;margin-left:3px;'> *</span>",
          "errorLabel": "Location",
          "key": "custom_location",
          "type": "select",
          "input": true,
          "placeholder": "Select a location",
          "customClass": "mb-4",
          "customConditional": "show = ['Clockin', 'Attendance Adjustment'].includes(data.request_type || '');",
          "validate": {
            "customMessage": "Location is required",
            "custom": "valid = ['Clockin', 'Attendance Adjustment'].includes(data.request_type) ? !!input : true;"
          },
          "data": {
            "values": [
              {
                "label": "Office",
                "value": "Office"
              },
              {
                "label": "Home",
                "value": "Home"
              },
              {
                "label": "Field Duty",
                "value": "Field Duty"
              }
            ]
          }
        },
        {
          "label": "Message",
          "key": "explanation",
          "type": "textarea",
          "input": true,
          "placeholder": "Provide additional details...",
          "rows": 4,
          "customClass": "mb-4"
        },
        {
          "label": "Attachments",
          "key": "attachments",
          "type": "file",
          "input": true,
          "multiple": true,
          "size": "false",
          "storage": "customfiles",
          "fileReader": false,
          "privateDownload": false,
          "filePattern": ".pdf,.doc,.docx,.jpg,.jpeg,.png",
          "tooltip": "Upload receipts or supporting documents.",
          "conditional": {
            "show": true,
            "when": "show_attachment",
            "eq": true
          }
        }
      ]
    }
  ]
}