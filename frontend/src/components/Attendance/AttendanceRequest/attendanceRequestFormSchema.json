{
  "title": "Attendance Request",
  "name": "attendanceRequest",
  "path": "attendance-request",
  "display": "form",
  "components": [
    {
      "type": "panel",
      "key": "attendanceRequestPanel",
      "label": "Attendance Request",
      "title": "Attendance Request",
      "hideLabel": true,
      "customClass": "bg-white rounded-lg",
      "components": [
        {
          "type": "hidden",
          "key": "isForOthers",
          "input": true,
          "defaultValue": false
        },
        {
          "type": "hidden",
          "key": "currentEmployeeId",
          "input": true,
          "defaultValue": ""
        },
        {
          "type": "hidden",
          "key": "currentUserId",
          "input": true,
          "defaultValue": ""
        },
        {
          "label": "Employee",
          "key": "employee",
          "type": "select",
          "input": true,
          "placeholder": "Select Employee",
          "customClass": "mb-4",
          "validate": {
            "required": true
          },
          "customConditional": "show = data.isForOthers === true;",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/hrms.hr.doctype.employee.employee.get_employee_reportees"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.employee_name }} ({{ item.name }})</span>",
          "selectValues": "message",
          "refreshOn": "isForOthers",
          "clearOnRefresh": false,
          "lazyLoad": false
        },
        {
          "label": "Company",
          "key": "company",
          "type": "textfield",
          "input": true,
          "placeholder": "Loading company information...",
          "customClass": "mb-4",
          "disabled": true,
          "customConditional": "show = data.isForOthers === true;",
          "calculateValue": "value = 'Loading...'",
          "clearOnHide": false,
          "dataSrc": "url",
          "data": {
            "url": "/api/method/hrms.hr.doctype.employee.employee.get_employee?employee={{data.employee}}"
          }
        },
        {
          "label": "Request Type",
          "key": "request_type",
          "type": "select",
          "input": true,
          "placeholder": "Select a Request Type",
          "customClass": "mb-4",
          "validate": {
            "required": true
          },
          "dataSrc": "url",
          "data": {
            "url": "api/method/cn_leave_shift_managment.cn_leave_shift_managment.overrides.attendace_request.get_active_attendance_policy?employee=HR-EMP-00001"
          },
          "valueProperty": "value",
          "template": "<span>{{ item.label }}</span>",
          "selectValues": "message.request_types",
          "refreshOn": "employee",
          "clearOnRefresh": false,
          "lazyLoad": false
        },
        {
          "label": "Current Shift",
          "key": "current_shift",
          "type": "textfield",
          "input": true,
          "placeholder": "Loading shift information...",
          "customClass": "mb-4",
          "disabled": true,
          "defaultValue": "Not Assigned",
          "clearOnHide": false,
          "calculateValue": "value = data.shift_name || 'Not Assigned'"
        },
        {
          "type": "columns",
          "key": "shiftColumns",
          "columns": [
            {
              "width": 6,
              "components": [
                {
                  "type": "textfield",
                  "key": "shift_start",
                  "label": "Shift Start",
                  "placeholder": "Loading shift information...",
                  "input": true,
                  "defaultValue": "Not Assigned",
                  "customClass": "mb-4",
                  "disabled": true,
                  "clearOnHide": false,
                  "calculateValue": "value = data.shift_start_time || 'Not Assigned'"
                }
              ]
            },
            {
              "width": 6,
              "components": [
                {
                  "type": "textfield",
                  "key": "shift_end",
                  "label": "Shift End",
                  "placeholder": "Loading shift information...",
                  "input": true,
                  "defaultValue": "Not Assigned",
                  "customClass": "mb-4",
                  "disabled": true,
                  "clearOnHide": false,
                  "calculateValue": "value = data.shift_end_time || 'Not Assigned'"
                }
              ]
            }
          ]
        },
        {
          "type": "hidden",
          "key": "shift_name",
          "input": true,
          "dataSrc": "url",
          "data": {
            "url": "/api/method/hrms.hr.doctype.employee_shift.employee_shift.get_employee_shift?user_id={{data.currentUserId}}&employee={{data.employee}}"
          },
          "valueProperty": "shift",
          "selectValues": "message",
          "refreshOn": "employee"
        },
        {
          "type": "hidden",
          "key": "shift_start_time",
          "input": true,
          "calculateValue": "value = data.shift_name ? 'Loading...' : 'Not Assigned'"
        },
        {
          "type": "hidden",
          "key": "shift_end_time",
          "input": true,
          "calculateValue": "value = data.shift_name ? 'Loading...' : 'Not Assigned'"
        },
        {
          "label": "From Date",
          "key": "from_date",
          "type": "datetime",
          "input": true,
          "widget": {
            "type": "calendar"
          },
          "format": "dd-MM-yyyy",
          "placeholder": "dd-mm-yyyy",
          "customClass": "mb-4",
          "enableTime": false,
          "validate": {
            "required": true
          },
          "disabled": false,
          "redrawOn": "request_type"
        },
        {
          "label": "To Date",
          "key": "to_date",
          "type": "datetime",
          "input": true,
          "widget": {
            "type": "calendar"
          },
          "format": "dd-MM-yyyy",
          "placeholder": "dd-mm-yyyy",
          "customClass": "mb-4",
          "enableTime": false,
          "validate": {
            "required": true
          },
          "customConditional": "show = !['Clockin'].includes(data.request_type || '');",
          "calculateValue": "value = data.request_type === 'Short Attendance Request' ? data.from_date : value",
          "disabled": false
        },
        {
          "label": "From Time",
          "key": "custom_from_time",
          "type": "datetime",
          "input": true,
          "enableDate": false,
          "enableTime": true,
          "format": "HH:mm:ss",
          "placeholder": "hh:mm",
          "customClass": "mb-4",
          "validate": {
            "required": true,
            "customMessage": "From Time is required",
            "custom": "valid = ['Clockin', 'Short Attendance Request', 'On Duty', 'Attendance Adjustment', 'Out Duty'].includes(data.request_type) ? !!input : true;"
          },
          "customConditional": "show = ['Out Duty', 'Attendance Adjustment', 'Short Attendance Request', 'Clockin'].includes(data.request_type || '');",
          "widget": {
            "type": "calendar",
            "time_24hr": true,
            "noCalendar": true,
            "enableTime": true,
            "dateFormat": "H:i"
          }
        },
        {
          "label": "To Time",
          "key": "custom_to_time",
          "type": "datetime",
          "input": true,
          "enableDate": false,
          "enableTime": true,
          "format": "HH:mm:ss",
          "placeholder": "hh:mm",
          "customClass": "mb-4",
          "validate": {
            "required": true,
            "customMessage": "To Time is required",
            "custom": "valid = ['Short Attendance Request', 'On Duty', 'Attendance Adjustment', 'Out Duty'].includes(data.request_type) ? !!input : true;"
          },
          "customConditional": "show = ['Out Duty', 'Attendance Adjustment', 'Short Attendance Request'].includes(data.request_type || '');",
          "widget": {
            "type": "calendar",
            "time_24hr": true,
            "noCalendar": true,
            "enableTime": true,
            "dateFormat": "H:i"
          }
        },
        {
          "label": "Overnight Out Duty",
          "key": "overnight_out_duty",
          "type": "checkbox",
          "input": true,
          "customClass": "mb-4",
          "customConditional": "show = data.request_type === 'Out Duty';",
          "defaultValue": false
        },
        {
          "label": "Latest Check-In Time",
          "key": "latest_checkin_time",
          "type": "textfield",
          "input": true,
          "disabled": true,
          "customClass": "mb-4",
          "defaultValue": "N/A",
          "clearOnHide": false,
          "customConditional": "show = data.request_type === 'Attendance Adjustment';",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/hrms.hr.doctype.employee_checkin.employee_checkin.get_latest_checkin?employee={{data.employee || data.currentEmployeeId}}&from_date={{data.from_date}}&to_date={{data.to_date}}"
          },
          "valueProperty": "time",
          "selectValues": "message",
          "refreshOn": "from_date,to_date,employee"
        },
        {
          "label": "Latest Check-Out Time",
          "key": "latest_checkout_time",
          "type": "textfield",
          "input": true,
          "disabled": true,
          "customClass": "mb-4",
          "defaultValue": "N/A",
          "clearOnHide": false,
          "customConditional": "show = data.request_type === 'Attendance Adjustment';",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/hrms.hr.doctype.employee_checkin.employee_checkin.get_latest_checkout?employee={{data.employee || data.currentEmployeeId}}&from_date={{data.from_date}}&to_date={{data.to_date}}"
          },
          "valueProperty": "time",
          "selectValues": "message",
          "refreshOn": "from_date,to_date,employee"
        },
        {
          "label": "Select Shift",
          "key": "select_shift",
          "type": "select",
          "input": true,
          "placeholder": "Select shift",
          "customClass": "mb-4",
          "customConditional": "show = data.request_type === 'Shift Change';",
          "dataSrc": "url",
          "data": {
            "url": "/api/resource/Shift Type"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.name }}</span>",
          "selectValues": "data",
          "lazyLoad": false
        },
        {
          "label": "Reason",
          "key": "custom__request_reason",
          "type": "select",
          "input": true,
          "placeholder": "Select a reason",
          "customClass": "mb-4",
          "customConditional": "show = data.request_type !== 'Shift Change';",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/hrms.hr.doctype.attendance_reason.attendance_reason.get_reasons?request_type={{data.request_type}}"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.reason }}</span>",
          "selectValues": "message",
          "refreshOn": "request_type",
          "clearOnRefresh": true,
          "lazyLoad": false
        },
        {
          "label": "Location",
          "key": "custom_location",
          "type": "select",
          "input": true,
          "placeholder": "Select a location",
          "customClass": "mb-4",
          "customConditional": "show = ['Clockin', 'Attendance Adjustment'].includes(data.request_type || '');",
          "validate": {
            "required": true,
            "customMessage": "Location is required",
            "custom": "valid = ['Clockin', 'Attendance Adjustment'].includes(data.request_type) ? !!input : true;"
          },
          "data": {
            "values": [
              {
                "label": "Office",
                "value": "Office"
              },
              {
                "label": "Home",
                "value": "Home"
              },
              {
                "label": "Field Duty",
                "value": "Field Duty"
              }
            ]
          }
        },
        {
          "label": "Message",
          "key": "message",
          "type": "textarea",
          "input": true,
          "placeholder": "Provide additional details...",
          "rows": 4,
          "customClass": "mb-4"
        },
        {
          "label": "Attachments",
          "key": "attachments",
          "type": "file",
          "input": true,
          "multiple": false,
          "storage": "customBase64",
          "filePattern": ".pdf,.doc,.docx,.jpg,.jpeg,.png",
          "tooltip": "Upload receipts or supporting documents.",
          "validate": {
            "required": false
          }
        }
      ]
    }
  ]
}
