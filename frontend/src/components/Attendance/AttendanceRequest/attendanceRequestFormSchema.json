{
  "title": "Attendance Request",
  "name": "attendanceRequest",
  "path": "attendance-request",
  "display": "form",
  "components": [
    {
      "type": "panel",
      "key": "attendanceRequestPanel",
      "label": "Attendance Request",
      "title": "Attendance Request",
      "hideLabel": true,
      "customClass": "bg-white rounded-lg",
      "components": [
        {
          "type": "hidden",
          "key": "isForOthers",
          "input": true,
          "defaultValue": false
        },
        {
          "type": "hidden",
          "key": "currentEmployeeId",
          "input": true,
          "defaultValue": ""
        },
        {
          "type": "hidden",
          "key": "currentUserId",
          "input": true,
          "defaultValue": ""
        },
        {
          "label": "Employee *",
          "key": "employee",
          "type": "select",
          "input": true,
          "placeholder": "Select Employee",
          "customClass": "mb-4",
          "validate": {
            "required": true
          },
          "customConditional": "show = data.isForOthers === true;",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/cn_leave_shift_managment.api.get_reportees"
          },
          "valueProperty": "",
          "logic": [
            {
              "name": "update company",
              "trigger": {
                "type": "event",
                "event": "change"
              },
              "actions": [
                {
                  "name": "company action",
                  "type": "customAction",
                  "customAction": "const company = instance.root.getComponent('company'); if (company && instance.dataValue) { company.setValue(instance.dataValue.company, { fromLogic: true }); }"
                }
              ]
            }
          ],
          "template": "<span>{{ item.employee_name }} ({{ item.name }})</span>",
          "selectValues": "message",
          "refreshOn": "isForOthers",
          "clearOnRefresh": false,
          "lazyLoad": false
        },
        {
          "label": "Company",
          "key": "company",
          "type": "textfield",
          "placeholder": "Company",
          "input": true,
          "customClass": "mb-4",
          "disabled": true,
          "customConditional": "show = data.isForOthers === true;",
          "customDefaultValue": " ",
          "calculateValue": " ",
          "allowCalculateOverride": true,
          "applyMaskOn": "change"
        },
        {
          "label": "Request Type *",
          "key": "request_type",
          "type": "select",
          "input": true,
          "placeholder": "Select a Request Type",
          "customClass": "mb-4",
          "validate": {
            "required": true
          },
          "data": {
            "values": [
              {
                "label": "Clockin Request",
                "value": "Clockin"
              },
              {
                "label": "Out Duty Request",
                "value": "Out Duty"
              },
              {
                "label": "Short Attendance Request",
                "value": "Short Attendance Request"
              },
              {
                "label": "Attendance Adjustment",
                "value": "Attendance Adjustment"
              }
            ]
          }
        },
        {
    "label": "From Date *",
    "key": "from_date",
    "type": "datetime",
    "input": true,
    "widget": {
      "type": "calendar",
    "minDate": "today"
    },
    "format": "dd-MM-yyyy",
    "placeholder": "dd-mm-yyyy",
    "customClass": "mb-4",
    "enableTime": false,
    "validate": {
      "required": true,
      "custom": "if (input && moment(input).isBefore(moment().startOf('day'))) { return 'From Date cannot be before today'; } return true;"
    },
    "disabled": false,
    "redrawOn": "request_type"
  },
  {
    "label": "To Date *",
    "key": "to_date",
    "type": "datetime",
    "input": true,
    "widget": {
      "type": "calendar"
    },
    "format": "dd-MM-yyyy",
    "placeholder": "dd-mm-yyyy",
    "customClass": "mb-4",
    "enableTime": false,
    "validate": {
      "required": true,
      "custom": "if (data.from_date && input && moment(input).isBefore(moment(data.from_date))) { return 'To Date cannot be before From Date'; } return true;"
    },
    "customConditional": "show = !['Clockin'].includes(data.request_type || '');",
    "calculateValue": "value = data.request_type === 'Short Attendance Request' ? data.from_date : value",
    "disabled": false,
    "redrawOn": "from_date"
  },
        {
          "label": "From Time *",
          "key": "custom_from_time",
          "type": "datetime",
          "input": true,
          "enableDate": false,
          "enableTime": true,
          "format": "HH:mm:ss",
          "placeholder": "hh:mm",
          "customClass": "mb-4",
          "validate": {
            "required": true,
            "customMessage": "From Time is required",
            "custom": "valid = ['Clockin', 'Short Attendance Request', 'On Duty', 'Attendance Adjustment', 'Out Duty'].includes(data.request_type) ? !!input : true;"
          },
          "customConditional": "show = ['Out Duty', 'Attendance Adjustment', 'Short Attendance Request', 'Clockin'].includes(data.request_type || '');",
          "widget": {
            "type": "calendar",
            "time_24hr": true,
            "noCalendar": true,
            "enableTime": true,
            "dateFormat": "H:i"
          }
        },
        {
          "label": "To Time *",
          "key": "custom_to_time",
          "type": "datetime",
          "input": true,
          "enableDate": false,
          "enableTime": true,
          "format": "HH:mm:ss",
          "placeholder": "hh:mm",
          "customClass": "mb-4",
          "validate": {
            "required": true,
            "customMessage": "To Time is required",
            "custom": "valid = ['Short Attendance Request', 'On Duty', 'Attendance Adjustment', 'Out Duty'].includes(data.request_type) ? !!input : true;"
          },
          "customConditional": "show = ['Out Duty', 'Attendance Adjustment', 'Short Attendance Request'].includes(data.request_type || '');",
          "widget": {
            "type": "calendar",
            "time_24hr": true,
            "noCalendar": true,
            "enableTime": true,
            "dateFormat": "H:i"
          }
        },
        {
          "label": "Overnight Out Duty",
          "key": "overnight_out_duty",
          "type": "checkbox",
          "input": true,
          "customClass": "mb-4",
          "customConditional": "show = data.request_type === 'Out Duty';",
          "defaultValue": false
        },
        {
          "label": "Latest Check-In Time",
          "key": "latest_checkin_time",
          "type": "textfield",
          "input": true,
          "disabled": true,
          "customClass": "mb-4",
          "defaultValue": "N/A",
          "clearOnHide": false,
          "customConditional": "show = data.request_type === 'Attendance Adjustment';",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/hrms.hr.doctype.employee_checkin.employee_checkin.get_latest_checkin?employee={{data.employee || data.currentEmployeeId}}&from_date={{data.from_date}}&to_date={{data.to_date}}"
          },
          "valueProperty": "time",
          "selectValues": "message",
          "refreshOn": "from_date,to_date,employee"
        },
        {
          "label": "Latest Check-Out Time",
          "key": "latest_checkout_time",
          "type": "textfield",
          "input": true,
          "disabled": true,
          "customClass": "mb-4",
          "defaultValue": "N/A",
          "clearOnHide": false,
          "customConditional": "show = data.request_type === 'Attendance Adjustment';",
          "dataSrc": "url",
          "data": {
            "url": "/api/method/hrms.hr.doctype.employee_checkin.employee_checkin.get_latest_checkout?employee={{data.employee || data.currentEmployeeId}}&from_date={{data.from_date}}&to_date={{data.to_date}}"
          },
          "valueProperty": "time",
          "selectValues": "message",
          "refreshOn": "from_date,to_date,employee"
        },
        {
          "label": "Select Shift",
          "key": "select_shift",
          "type": "select",
          "input": true,
          "placeholder": "Select shift",
          "customClass": "mb-4",
          "customConditional": "show = data.request_type === 'Shift Change';",
          "dataSrc": "url",
          "data": {
            "url": "/api/resource/Shift Type"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.name }}</span>",
          "selectValues": "data",
          "lazyLoad": false
        },
        {
          "label": "Reason",
          "key": "custom__request_reason",
          "type": "select",
          "input": true,
          "placeholder": "Select a reason",
          "customClass": "mb-4",
          "customConditional": "show = data.request_type !== 'Shift Change';",
          "dataSrc": "url",
          "data": {
            "url": "/api/resource/Reason?fields=[\"name\",\"reason\",\"reason_type\"]&filters=[[\"reference_doctype\",\"=\",\"Attendance Request\"]]"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.reason }}</span>",
          "selectValues": "data",
          "refreshOn": "request_type",
          "clearOnRefresh": true,
          "lazyLoad": false
        },
        {
          "label": "Location *",
          "key": "custom_location",
          "type": "select",
          "input": true,
          "placeholder": "Select a location",
          "customClass": "mb-4",
          "customConditional": "show = ['Clockin', 'Attendance Adjustment'].includes(data.request_type || '');",
          "validate": {
            "required": true,
            "customMessage": "Location is required",
            "custom": "valid = ['Clockin', 'Attendance Adjustment'].includes(data.request_type) ? !!input : true;"
          },
          "data": {
            "values": [
              {
                "label": "Office",
                "value": "Office"
              },
              {
                "label": "Home",
                "value": "Home"
              },
              {
                "label": "Field Duty",
                "value": "Field Duty"
              }
            ]
          }
        },
        {
          "label": "Message",
          "key": "message",
          "type": "textarea",
          "input": true,
          "placeholder": "Provide additional details...",
          "rows": 4,
          "customClass": "mb-4"
        },
        {
          "label": "Attachments",
          "key": "attachments",
          "type": "file",
          "input": true,
          "multiple": false,
          "storage": "customBase64",
          "filePattern": ".pdf,.doc,.docx,.jpg,.jpeg,.png",
          "tooltip": "Upload receipts or supporting documents.",
          "validate": {
            "required": false
          }
        }
      ]
    }
  ]
}
