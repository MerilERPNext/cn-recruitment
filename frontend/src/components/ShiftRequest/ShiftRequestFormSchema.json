{
    "title": "Request Shift Change",
    "name": "requestShiftChange",
    "path": "request-shift-change",
    "display": "form",
    "components": [
        {
            "type": "columns",
            "key": "dateRange",
            "label": "Date Range",
            "columns": [
                {
                    "components": [
                        {
                            "type": "datetime",
                            "key": "fromDate",
                            "label": "From Date",
                            "errorLabel": "From Date",
                            "input": true,
                            "format": "dd/MM/yyyy",
                            "enableDate": true,
                            "enableTime": false,
                            "defaultValue": "",
                            "validate": {
                            }
                        }
                    ]
                },
                {
                    "components": [
                        {
                            "type": "datetime",
                            "key": "toDate",
                            "label": "To Date",
                            "errorLabel": "To Date",
                            "input": true,
                            "format": "dd/MM/yyyy",
                            "enableDate": true,
                            "enableTime": false,
                            "defaultValue": "",
                            "validate": {
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "select",
            "key": "shiftType",
            "label": "Shift Type",
            "errorLabel": "Shift Type",
            "input": true,
            "placeholder": "Select shift type",
            "dataSrc": "url",
            "data": {
                "url": "/api/resource/Shift Type?fields=[\"name\"]&order_by=creation desc"
            },
            "valueProperty": "name",
            "template": "<span>{{ item.name }}</span>",
            "selectValues": "data",
            "validate": {
            },
            "defaultValue": ""
        },
        {
            "type": "textarea",
            "key": "reason",
            "label": "Reason",
            "errorLabel": "Reason",
            "placeholder": "Enter reason",
            "input": true,
            "validate": {
            }
        }
    ]
}