{
    "title": "Employee Benefit Claim",
    "name": "benefitClaim",
    "path": "benefit-claim",
    "display": "form",
    "components": [
        {
            "type": "panel",
            "key": "benefitPanel",
            "label": "Benefit Claim Details",
            "title": "Benefit Claim Details",
            "hideLabel": true,
            "customClass": "bg-white rounded-lg",
            "components": [
                {
                    "type": "hidden",
                    "key": "currentEmployeeId",
                    "input": true,
                    "defaultValue": ""
                },
                {
                    "type": "hidden",
                    "key": "claimDate",
                    "input": true,
                    "defaultValue": ""
                },
                {
                    "type": "select",
                    "key": "earning_component",
                    "label": "Claim Benefit For",
                    "errorLabel": "Claim Benefit For",
                    "placeholder": "Select Benefit Component",
                    "validate": {},
                    "input": true,
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/method/cn_indian_payroll.cn_indian_payroll.overrides.webapp_api.benefit_claim.benefit_claim?employee={{data.currentEmployeeId}}&claim_date={{data.claimDate}}"
                    },
                    "valueProperty": "value",
                    "template": "<span>{{ item.label }}</span>",
                    "selectValues": "message.component_array",
                    "refreshOn": "currentEmployeeId,claimDate",
                    "clearOnRefresh": false,
                    "lazyLoad": false,
                    "customClass": "w-full"
                },
                {
                    "type": "number",
                    "key": "claimed_amount",
                    "label": "Claimed Amount",
                    "errorLabel": "Claimed Amount",
                    "input": true,
                    "validate": {
                        "customMessage": "Claimed amount cannot be greater than Max amount eligible",
                        "custom": "valid = Number(data.custom_max_amount) < input ? false : true;"
                    }
                },
                {
                    "type": "select",
                    "key": "custom_max_amount",
                    "label": "Max Amount Eligible",
                    "placeholder": "0.00",
                    "input": true,
                    "disabled": true,
                    "dataSrc": "custom",
                    "data": {
                        "custom": "values = []; if (data.currentEmployeeId && data.earning_component) { const xhr = new XMLHttpRequest(); xhr.open('GET', '/api/method/cn_indian_payroll.cn_indian_payroll.overrides.webapp_api.benefit_claim.get_max_amount?employee=' + data.currentEmployeeId + '&earning_component=' + data.earning_component, false); xhr.send(); if (xhr.status === 200) { const res = JSON.parse(xhr.responseText); if (res.message && res.message.data) { values = [{currently_allowed: res.message.data.currently_allowed}]; } } } if (values.length && !data.custom_max_amount) { data.custom_max_amount = values[0].currently_allowed; }"
                    },
                    "valueProperty": "currently_allowed",
                    "template": "<span>{{ item.currently_allowed }}</span>",
                    "refreshOn": "earning_component",
                    "clearOnRefresh": true,
                    "customConditional": "show = !!data.earning_component;"
                },
                {
                    "type": "textarea",
                    "key": "custom_note_by_employee",
                    "label": "Note by employee",
                    "placeholder": "Add a note...",
                    "rows": 4
                },
                {
                    "type": "select",
                    "key": "custom_payroll_period",
                    "label": "Payroll Period",
                    "placeholder": "Payroll Period",
                    "input": true,
                    "dataSrc": "custom",
                    "data": {
                        "custom": "values=[];if(data.currentEmployeeId&&data.earning_component){xhr=new XMLHttpRequest();xhr.open('GET','/api/method/cn_indian_payroll.cn_indian_payroll.overrides.webapp_api.benefit_claim.get_max_amount?employee='+data.currentEmployeeId+'&earning_component='+data.earning_component,false);xhr.send();if(xhr.status===200){res=JSON.parse(xhr.responseText);if(res.message&&res.message.data&&res.message.data.payroll_period){values=[{payroll_period:res.message.data.payroll_period}];data.custom_payroll_period=res.message.data.payroll_period;}}}"
                    },
                    "valueProperty": "payroll_period",
                    "template": "<span>{{ item.payroll_period }}</span>",
                    "refreshOn": "earning_component",
                    "clearOnRefresh": true,
                    "hidden": true
                },
                {
                    "label": "Attachments",
                    "key": "attachments",
                    "type": "file",
                    "input": true,
                    "multiple": true,
                    "size": "false",
                    "storage": "customfiles",
                    "fileReader": false,
                    "privateDownload": false,
                    "filePattern": ".pdf,.doc,.docx,.jpg,.jpeg,.png",
                    "tooltip": "Upload receipts or supporting documents.",
                    "validate": {
                        "required": false
                    }
                }
            ]
        }
    ]
}