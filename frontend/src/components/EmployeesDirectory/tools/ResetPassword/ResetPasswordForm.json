{
    "title": "Reset Password",
    "name": "resetPasswordForm",
    "path": "reset-password-form",
    "display": "form",
    "components": [
        {
            "label": "New Password",
            "key": "new_password",
            "type": "password",
            "placeholder": "New Password",
            "input": true,
            "customClass": "mb-4",
            "errorLabel": "New Password",
            "applyMaskOn": "change",
            "validate": {
                "required": true
            }
        },
        {
            "label": "Confirm Password",
            "key": "confirm_password",
            "type": "password",
            "placeholder": "Confirm Password",
            "input": true,
            "customClass": "mb-4",
            "errorLabel": "Confirm Password",
            "applyMaskOn": "change",
            "validate": {
                "required": true,
                "custom": "valid = (input === data.new_password) ? true : 'Passwords do not match.';"
            }
        },
        {
            "type": "checkbox",
            "key": "send_email",
            "label": "Send Email Notification to Employee",
            "input": true
        }
    ]
}