{
    "title": "Employee Directory Filters",
    "name": "employeeDirectoryFilters",
    "path": "employee-directory-filters",
    "display": "form",
    "components": [
        {
            "label": "Employee Status",
            "widget": "choicesjs",
            "tableView": true,
            "defaultValue": "Active",
            "data": {
                "values": [
                    {
                        "label": "Active Employees",
                        "value": "Active"
                    },
                    {
                        "label": "Inactive Employees",
                        "value": "Inactive"
                    }
                ]
            },
            "validateWhenHidden": false,
            "key": "status",
            "type": "select",
            "input": true
        },
        {
            "label": "Select Company",
            "key": "company",
            "type": "select",
            "input": true,
            "multiple": true,
            "placeholder": "Select Company",
            "customClass": "mb-4",
            "dataSrc": "url",
            "data": {
                "url": "/api/method/cn_hrms_core.cn_hrms_core.apis.employee_history.get_designation_hierarchy_options"
            },
            "selectValues": "message.data.companies",
            "valueProperty": "name",
            "template": "<span>{{ item.company_name }}</span>",
            "lazyLoad": false,
            "clearOnRefresh": false
        },
        {
            "label": "Select Departments",
            "key": "department",
            "type": "select",
            "input": true,
            "placeholder": "Select Departments",
            "dataSrc": "url",
            "data": {
                "url": "/api/method/cn_hrms_core.cn_hrms_core.apis.employee_history.get_designation_hierarchy_options?company={{ data.company }}"
            },
            "refreshOn": "company",
            "clearOnRefresh": true,
            "selectValues": "message.data.departments",
            "valueProperty": "name",
            "template": "<span>{{ item.department_name }} - ({{ item.name }})</span>",
            "lazyLoad": false
        },
        {
            "label": "Select Employee Type",
            "key": "employment_type",
            "type": "select",
            "input": true,
            "placeholder": "Select Employee Type",
            "dataSrc": "url",
            "data": {
                "url": "/api/resource/Employment Type?fields=[\"*\"]"
            },
            "valueProperty": "name",
            "template": "<span>{{item.employee_type_name}}</span>",
            "selectValues": "data",
            "lazyLoad": false
        },
        {
            "label": "Select Current Office Location",
            "key": "branch",
            "type": "select",
            "input": true,
            "placeholder": "Select Current Office Location",
            "customClass": "mb-4",
            "dataSrc": "url",
            "data": {
                "url": "/api/resource/Branch?fields=[\"*\"]"
            },
            "valueProperty": "name",
            "template": "<span>{{item.branch}}</span>",
            "selectValues": "data",
            "lazyLoad": false
        },
        {
            "label": "Select Business Unit",
            "key": "custom_business_unit",
            "type": "select",
            "input": true,
            "placeholder": "Select Business Unit",
            "customClass": "mb-4",
            "dataSrc": "url",
            "data": {
                "url": "/api/resource/Business Unit?fields=[\"*\"]"
            },
            "valueProperty": "name",
            "template": "<span>{{ item.business_unit }}</span>",
            "selectValues": "data",
            "lazyLoad": false
        },
        {
            "content": "<label class=\"mb-1 font-medium text-gray-700 block\">DOJ Date</label>",
            "key": "doj_date_label",
            "type": "htmlelement",
            "tag": "div",
            "className": "w-full mt-4",
            "input": false
        },
        {
            "label": "Columns",
            "columns": [
                {
                    "components": [
                        {
                            "label": "DOJ From",
                            "hideLabel": true,
                            "key": "doj_from",
                            "type": "datetime",
                            "input": true,
                            "enableTime": false,
                            "format": "dd-MM-yyyy",
                            "placeholder": "dd-mm-yyyy",
                            "customClass": "mb-4"
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md"
                },
                {
                    "components": [
                        {
                            "label": "DOJ To",
                            "hideLabel": true,
                            "key": "doj_to",
                            "type": "datetime",
                            "input": true,
                            "enableTime": false,
                            "format": "dd-MM-yyyy",
                            "placeholder": "dd-mm-yyyy",
                            "customClass": "mb-4"
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md"
                }
            ],
            "key": "dojColumns",
            "type": "columns",
            "input": false,
            "tableView": false
        }
    ]
}