{
    "title": "Employment History",
    "name": "employmentHistory",
    "path": "employment-history",
    "display": "form",
    "components": [
        {
            "type": "panel",
            "key": "reportingDetailsPanel",
            "label": "Reporting Details",
            "title": "Reporting Details",
            "hideLabel": true,
            "customClass": "bg-white rounded-lg",
            "components": [
                {
                    "type": "hidden",
                    "key": "defaultReportsTo",
                    "input": true
                },
                {
                    "type": "hidden",
                    "key": "defaultDottedLineManager",
                    "input": true
                },
                {
                    "type": "hidden",
                    "key": "defaultHOD",
                    "input": true
                },
                {
                    "type": "hidden",
                    "key": "defaultCXO",
                    "input": true
                },
                {
                    "type": "hidden",
                    "key": "defaultHRBP",
                    "input": true
                },
                {
                    "label": "Reports to",
                    "errorLabel": "Reports to",
                    "key": "reports_to",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select Reports to",
                    "customClass": "mb-4",
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/method/cn_leave_shift_managment.api.get_reportees"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.employee_name }} ({{ item.name }})</span>",
                    "selectValues": "message",
                    "refreshOn": "isForOthers",
                    "clearOnRefresh": false,
                    "lazyLoad": false,
                    "customDefaultValue": "value = data.defaultReportsTo ? data.defaultReportsTo : null;"
                },
                {
                    "label": "Dotted Line Manager",
                    "errorLabel": "Dotted Line Manager",
                    "key": "custom_dotted_line_manager",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select Dotted Line Manager",
                    "customClass": "mb-4",
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/method/cn_leave_shift_managment.api.get_reportees"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.employee_name }} ({{ item.name }})</span>",
                    "selectValues": "message",
                    "refreshOn": "isForOthers",
                    "clearOnRefresh": false,
                    "lazyLoad": false,
                    "customDefaultValue": "value = data.defaultDottedLineManager ? data.defaultDottedLineManager : null;"
                },
                {
                    "label": "HOD",
                    "errorLabel": "HOD",
                    "key": "custom_hod",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select HOD",
                    "customClass": "mb-4",
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/method/cn_leave_shift_managment.api.get_reportees"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.employee_name }} ({{ item.name }})</span>",
                    "selectValues": "message",
                    "refreshOn": "isForOthers",
                    "clearOnRefresh": false,
                    "lazyLoad": false,
                    "customDefaultValue": "value = data.defaultHOD ? data.defaultHOD : null;"
                },
                {
                    "label": "CXO",
                    "errorLabel": "CXO",
                    "key": "custom_cxo",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select CXO",
                    "customClass": "mb-4",
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/method/cn_leave_shift_managment.api.get_reportees"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.employee_name }} ({{ item.name }})</span>",
                    "selectValues": "message",
                    "refreshOn": "isForOthers",
                    "clearOnRefresh": false,
                    "lazyLoad": false,
                    "customDefaultValue": "value = data.defaultCXO ? data.defaultCXO : null;"
                },
                {
                    "label": "HRBP",
                    "errorLabel": "HRBP",
                    "key": "custom_hrbp",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select HRBP",
                    "customClass": "mb-4",
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/method/cn_leave_shift_managment.api.get_reportees"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.employee_name }} ({{ item.name }})</span>",
                    "selectValues": "message",
                    "refreshOn": "isForOthers",
                    "clearOnRefresh": false,
                    "lazyLoad": false,
                    "customDefaultValue": "value = data.defaultHRBP ? data.defaultHRBP : null;"
                },
                {
                    "type": "datetime",
                    "key": "start_date",
                    "label": "Start Date",
                    "errorLabel": "Start Date",
                    "format": "dd-MM-yyyy",
                    "enableTime": false,
                    "input": true
                }
            ]
        }
    ]
}