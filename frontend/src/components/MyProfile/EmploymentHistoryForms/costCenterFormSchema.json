{
    "title": "Cost Center",
    "name": "costCenter",
    "path": "cost-center",
    "display": "form",
    "components": [
        {
            "type": "panel",
            "key": "costCenterPanel",
            "label": "Cost Center Details",
            "hideLabel": true,
            "customClass": "bg-white rounded-lg",
            "components": [
                {
                    "type": "datagrid",
                    "key": "allocations",
                    "label": "Allocations",
                    "components": [
                        {
                            "label": "Cost Center",
                            "errorLabel": "Cost Center",
                            "key": "cost_center",
                            "type": "select",
                            "input": true,
                            "placeholder": "Select Cost Center",
                            "dataSrc": "url",
                            "data": {
                                "url": "/api/resource/Cost%20Center?fields=[%22*%22]&filters=[[%22company%22,%22=%22,%22{{ data.company_filter }}%22],[%22disabled%22,%22=%22,0]]"
                            },
                            "valueProperty": "name",
                            "template": "<span>{{item.cost_center_name}} ({{ item.name }})</span>",
                            "selectValues": "data",
                            "lazyLoad": false,
                            "searchField": "cost_center_name",
                            "searchEnabled": true
                        },
                        {
                            "type": "number",
                            "key": "percentage",
                            "label": "Percentage (%)",
                            "placeholder": "e.g. 60",
                            "input": true,
                            "validate": {
                                "min": 1,
                                "max": 100
                            }
                        }
                    ]
                },
                {
                    "type": "datetime",
                    "key": "start_date",
                    "label": "Start Date",
                    "errorLabel": "Start Date",
                    "format": "dd-MM-yyyy",
                    "enableTime": false,
                    "input": true
                }
            ]
        }
    ]
}
