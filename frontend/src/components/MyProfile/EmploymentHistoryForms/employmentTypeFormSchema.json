{
    "title": "Employment Type",
    "name": "employmentType",
    "path": "employment-type",
    "display": "form",
    "components": [
        {
            "type": "panel",
            "key": "employmentTypePanel",
            "label": "Employment Type Details",
            "title": "Employment Type Details",
            "hideLabel": true,
            "customClass": "bg-white rounded-lg",
            "components": [
                {
                    "label": "Employment Type",
                    "errorLabel": "Employment Type",
                    "key": "employment_type",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select Employment Type",
                    "customClass": "mb-4",
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/method/cn_hrms_core.cn_hrms_core.apis.fetch_data.get_searched_doc_list?fields=[%22*%22]&doctype=Employment%20Type"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{item.reference_name}} ({{ item.name }})</span>",
                    "selectValues": "message",
                    "lazyLoad": false,
                    "searchField": "q",
                    "searchEnabled": true
                },
                {
                    "label": "Employment Subtype",
                    "errorLabel": "Employment Subtype",
                    "key": "employee_subtype",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select Employment Subtype",
                    "customClass": "mb-4",
                    "customConditional": "show = !!data.employment_type",
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/method/cn_hrms_core.cn_hrms_core.apis.employee_history.get_subtypes_by_employee_type?employee_type={{ data.employment_type }}"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.employee_sub_type }} ({{item.name}})</span>",
                    "selectValues": "message.data",
                    "refreshOn": "employment_type",
                    "clearOnRefresh": true,
                    "lazyLoad": false,
                    "searchField": "q",
                    "searchEnabled": true
                },
                {
                    "type": "datetime",
                    "key": "startDate",
                    "label": "Start Date",
                    "errorLabel": "Start Date",
                    "format": "dd-MM-yyyy",
                    "enableTime": false,
                    "input": true
                },
                {
                    "type": "datetime",
                    "key": "endDate",
                    "label": "End Date",
                    "errorLabel": "End Date",
                    "format": "dd-MM-yyyy",
                    "enableTime": false,
                    "input": true
                }
            ]
        }
    ]
}