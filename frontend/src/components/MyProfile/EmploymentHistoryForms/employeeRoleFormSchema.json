{
    "title": "Employee Role",
    "name": "employeeRole",
    "path": "employee-role",
    "display": "form",
    "components": [
        {
            "type": "panel",
            "key": "employeeRolePanel",
            "label": "Employee Role Details",
            "title": "Employee Role Details",
            "hideLabel": true,
            "customClass": "bg-white rounded-lg",
            "components": [
                {
                    "label": "Employee Role",
                    "errorLabel": "Employee Role",
                    "key": "employee_role",
                    "type": "select",
                    "input": true,
                    "placeholder": "Select Employee Role",
                    "customClass": "mb-4",
                    "dataSrc": "url",
                    "data": {
                        "url": "/api/method/cn_hrms_core.cn_hrms_core.apis.fetch_data.get_searched_doc_list?fields=[%22*%22]&doctype=Employee%20Role"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.name }}</span>",
                    "selectValues": "message",
                    "lazyLoad": false,
                    "searchField": "q",
                    "searchEnabled": true
                },
                {
                    "type": "datetime",
                    "key": "startDate",
                    "label": "Start Date",
                    "errorLabel": "Start Date",
                    "format": "dd-MM-yyyy",
                    "enableTime": false,
                    "input": true
                },
                {
                    "type": "datetime",
                    "key": "endDate",
                    "label": "End Date",
                    "errorLabel": "End Date",
                    "format": "dd-MM-yyyy",
                    "enableTime": false,
                    "input": true
                }
            ]
        }
    ]
}
