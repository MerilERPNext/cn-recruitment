{
    "title": "Employment History",
    "name": "employmentHistory",
    "path": "employment-history",
    "display": "form",
    "components": [
        {
            "type": "panel",
            "key": "employmentHistoryPanel",
            "label": "Employment History Details",
            "title": "Employment History Details",
            "hideLabel": true,
            "customClass": "bg-white rounded-lg",
            "components": [
                {
                    "type": "hidden",
                    "key": "companies",
                    "input": true
                },
                {
                    "type": "hidden",
                    "key": "departments",
                    "input": true
                },
                {
                    "type": "hidden",
                    "key": "designations",
                    "input": true
                },
                {
                    "type": "hidden",
                    "key": "functional_areas",
                    "input": true
                },
                {
                    "type": "select",
                    "key": "company",
                    "label": "Company",
                    "errorLabel": "Company",
                    "placeholder": "Select Company",
                    "input": true,
                    "dataSrc": "custom",
                    "data": {
                        "custom": "values = data.companies"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.name }}</span>",
                    "validateWhenHidden": false,
                    "customClass": "w-full"
                },
                {
                    "type": "select",
                    "key": "department",
                    "label": "Department",
                    "errorLabel": "Department",
                    "placeholder": "Select Department",
                    "validate": {},
                    "customConditional": "show = !!data.company",
                    "input": true,
                    "dataSrc": "custom",
                    "data": {
                        "custom": "values = data.departments"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.name }}</span>",
                    "validateWhenHidden": false,
                    "customClass": "w-full"
                },
                {
                    "type": "select",
                    "key": "designation",
                    "label": "Designation",
                    "errorLabel": "Designation",
                    "placeholder": "Select Designation",
                    "validate": {},
                    "customConditional": "show = !!data.department",
                    "input": true,
                    "dataSrc": "custom",
                    "data": {
                        "custom": "values = data.designations"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.name }}</span>",
                    "validateWhenHidden": false,
                    "customClass": "w-full"
                },
                {
                    "type": "select",
                    "key": "functional_area",
                    "label": "Functional Area",
                    "errorLabel": "Functional Area",
                    "placeholder": "Select Functional Area",
                    "customConditional": "show = !!data.designation",
                    "validate": {},
                    "input": true,
                    "dataSrc": "custom",
                    "data": {
                        "custom": "values = data.functional_areas"
                    },
                    "valueProperty": "name",
                    "template": "<span>{{ item.name }}</span>",
                    "validateWhenHidden": false,
                    "customClass": "w-full"
                },
                {
                    "label": "Start Date",
                    "tableView": false,
                    "datePicker": {
                        "disableWeekends": false,
                        "disableWeekdays": false
                    },
                    "enableMinDateInput": false,
                    "enableMaxDateInput": false,
                    "validateWhenHidden": false,
                    "key": "startDate",
                    "type": "datetime",
                    "input": true,
                    "widget": {
                        "type": "calendar",
                        "displayInTimezone": "viewer",
                        "locale": "en",
                        "useLocaleSettings": false,
                        "allowInput": true,
                        "mode": "single",
                        "enableTime": true,
                        "noCalendar": false,
                        "format": "yyyy-MM-dd hh:mm a",
                        "hourIncrement": 1,
                        "minuteIncrement": 1,
                        "time_24hr": false,
                        "minDate": null,
                        "disableWeekends": false,
                        "disableWeekdays": false,
                        "maxDate": null
                    }
                }
            ]
        }
    ]
}