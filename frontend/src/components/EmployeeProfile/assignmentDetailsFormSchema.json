{
    "title": "Assignment Details",
    "name": "assignmentDetails",
    "display": "form",
    "components": [
        {
            "type": "select",
            "key": "module",
            "input": true,
            "placeholder": "Select Module",
            "customClass": "mb-4",
            "hideLabel": true,
            "refreshOn": "doctype",
            "dataSrc": "url",
            "data": {
                "url": "/api/method/cn_hrms_core.cn_hrms_core.apis.assignment_details.get_modules"
            },
            "selectValues": "message.modules",
            "template": "<span>{{ item }}</span>",
            "lazyLoad": false,
            "validate": {
                "required": true
            }
        }
    ]
}