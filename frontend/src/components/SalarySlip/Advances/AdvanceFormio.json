{
  "title": "Advance Request",
  "name": "advanceRequest",
  "path": "advance-request",
  "display": "form",
  "components": [
    {
      "type": "panel",
      "key": "advanceRequestPanel",
      "label": "Advance Request",
      "title": "Advance Request",
      "hideLabel": true,
      "customClass": "bg-white rounded-lg",
      "components": [
        {
          "label": "Employee",
          "key": "employee",
          "type": "textfield",
          "input": true,
          "placeholder": "Enter employee ID/name",
          "disabled": true,
          "validate": { "required": true },
          "customClass": "mb-4"
        },
        {
          "label": "Advance Type",
          "key": "custom_advance_type",
          "type": "select",
          "input": true,
          "placeholder": "Select advance type",
          "validate": { "required": true },
          "dataSrc": "url",
          "data": {
            "url": "/api/resource/Advance Type?fields=[\"name\"]"
          },
          "valueProperty": "name",
          "template": "<span>{{ item.name }}</span>",
          "selectValues": "data",
          "lazyLoad": false,
          "refreshOn": "employee",
          "customClass": "mb-4",
"logic": [
  {
    "name": "Fetch Advance Amount Automatically",
    "event": "change",
    "trigger": {
      "type": "javascript",
      "javascript": "result = !!data.custom_advance_type;"
    },
    "actions": [
      {
        "name": "Fetch and Fill Advance Amount",
        "type": "custom",
        "custom": "if (data.employee && data.custom_advance_type) {\n  fetch(`/api/method/cn_indian_payroll.cn_indian_payroll.overrides.employee_advance.get_advance_amount_checking?employee=${data.employee}&advance_type=${data.custom_advance_type}`)\n    .then(res => res.json())\n    .then(result => {\n      if (result.message && result.message.advance_amount) {\n        const advanceAmountComp = instance.root.getComponent('advance_amount');\n        if (advanceAmountComp) {\n          advanceAmountComp.setValue(result.message.advance_amount);\n        }\n      } else {\n        console.warn('Advance amount not found in response', result);\n      }\n    })\n    .catch(err => console.error('Error fetching advance amount:', err));\n}"
      }
    ]
  }
]



        },
        {
          "label": "Advance Amount",
          "key": "advance_amount",
          "type": "currency",
          "input": true,
          "placeholder": "0.00",
          "validate": { "required": true, "min": 1 },
          "currency": "INR",
          "customClass": "mb-4"
        },
        {
          "label": "Repayment Type",
          "key": "custom_repayment_type",
          "type": "select",
          "input": true,
          "placeholder": "Select repayment type",
          "validate": { "required": true },
          "data": {
            "values": [
              { "label": "One Time", "value": "One Time" },
              { "label": "Recurring", "value": "Recurring" }
            ]
          },
          "customClass": "mb-4"
        },
        {
          "label": "Repayment Method",
          "key": "repayment_method",
          "type": "select",
          "input": true,
          "placeholder": "Select repayment method",
          "customConditional": "show = data.custom_repayment_type === 'Recurring';",
          "data": {
            "values": [
              { "label": "Repay Over Number of Periods", "value": "Repay Over Number of Periods" },
              { "label": "Repay Fixed Amount per Period", "value": "Repay Fixed Amount per Period" }
            ]
          },
          "customClass": "mb-4"
        },
        {
          "label": "Repayment Start Date",
          "key": "custom_repayment_start_date",
          "type": "datetime",
          "input": true,
          "enableTime": false,
          "format": "yyyy-MM-dd",
          "placeholder": "Select start date",
          "validate": { "required": true },
          "customConditional": "show = data.custom_repayment_type === 'One Time' || data.custom_repayment_type === 'Recurring';",
          "customClass": "mb-4"
        },
        {
          "label": "Repayment Period (Months)",
          "key": "repayment_periods",
          "type": "number",
          "input": true,
          "placeholder": "Number of months",
          "validate": { "required": true, "min": 1, "max": 36 },
          "customConditional": "show = data.custom_repayment_type === 'Recurring' && data.repayment_method === 'Repay Over Number of Periods';",
          "customClass": "mb-4"
        },
        {
          "label": "Monthly Repayment Amount",
          "key": "repayment_amount",
          "type": "number",
          "input": true,
          "placeholder": "0.00",
          "validate": { "required": true, "min": 1 },
          "customConditional": "show = data.custom_repayment_type === 'Recurring' && data.repayment_method === 'Repay Fixed Amount per Period';",
          "customClass": "mb-4"
        },
        {
          "label": "Purpose",
          "key": "purpose",
          "type": "textarea",
          "input": true,
          "placeholder": "Describe the purpose of advance",
          "validate": { "required": true },
          "rows": 4,
          "customClass": "mb-4"
        },
        {
          "label": "Attachments",
          "key": "attachments",
          "type": "file",
          "input": true,
          "multiple": false,
          "storage": "customBase64",
          "filePattern": ".pdf,.doc,.docx,.jpg,.jpeg,.png",
          "tooltip": "Upload supporting documents.",
          "validate": { "required": false },
          "customClass": "mb-4"
        }
      ]
    }
  ]
}
