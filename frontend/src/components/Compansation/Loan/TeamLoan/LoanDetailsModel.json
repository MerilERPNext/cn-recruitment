{
  "title": "Loan Details",
  "name": "loanDetails",
  "path": "loan-details",
  "display": "form",
  "components": [
    {
      "type": "panel",
      "key": "employeeInfoPanel",
      "label": "Employee Info",
      "hideLabel": true,
      "customClass": "mb-2",
      "components": [
        {
          "type": "columns",
          "key": "employeeInfoColumns",
          "label": "",
          "hideLabel": true,
          "columns": [
            {
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "components": [
                {
                  "type": "textfield",
                  "key": "applicant_name",
                  "label": "Employee",
                  "disabled": true,
                  "customClass": "mb-4",
                  "input": true
                }
              ]
            },
            {
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "components": [
                {
                  "type": "textfield",
                  "key": "loan_product",
                  "label": "Loan Type",
                  "disabled": true,
                  "customClass": "mb-4",
                  "input": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "panel",
      "key": "editableDetailsPanel",
      "label": "Loan Details",
      "hideLabel": true,
      "customClass": "mb-2",
      "components": [
        {
          "type": "columns",
          "key": "loanDetailsRow1",
          "label": "",
          "hideLabel": true,
          "columns": [
            {
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "components": [
                {
                  "type": "number",
                  "key": "loan_amount",
                  "label": "Loan Amount",
                  "placeholder": "Enter loan amount",
                  "validate": {
                    "min": 1
                  },
                  "customClass": "mb-4",
                  "input": true
                }
              ]
            },
            {
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "components": [
                {
                  "type": "number",
                  "key": "rate_of_interest",
                  "label": "Rate of Interest (%)",
                  "placeholder": "Enter rate of interest",
                  "validate": {
                    "min": 0
                  },
                  "customClass": "mb-4",
                  "input": true
                }
              ]
            }
          ]
        },
        {
          "type": "columns",
          "key": "loanDetailsRow2",
          "label": "",
          "hideLabel": true,
          "columns": [
            {
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "components": [
                {
                  "type": "select",
                  "key": "repayment_method",
                  "label": "Repayment Type",
                  "placeholder": "Select repayment type",
                  "data": {
                    "values": [
                      {
                        "label": "Repay Fixed Amount per Period",
                        "value": "Repay Fixed Amount per Period"
                      },
                      {
                        "label": "Repay Over Number of Periods",
                        "value": "Repay Over Number of Periods"
                      }
                    ]
                  },
                  "customClass": "mb-4",
                  "input": true
                }
              ]
            },
            {
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "components": [
                {
                  "type": "number",
                  "key": "monthly_repayment_amount",
                  "label": "Monthly Repayment Amount",
                  "placeholder": "Enter monthly repayment amount",
                  "customConditional": "show = ['Repay Fixed Amount per Period'].includes(data.repayment_method || '');",
                  "clearOnHide": false,
                  "validate": {
                    "min": 1
                  },
                  "customClass": "mb-4",
                  "input": true
                },
                {
                  "type": "number",
                  "key": "loan_tenure",
                  "label": "Loan Tenure",
                  "placeholder": "Enter tenure in months",
                  "customConditional": "show = ['Repay Over Number of Periods'].includes(data.repayment_method || '');",
                  "clearOnHide": false,
                  "validate": {
                    "min": 1
                  },
                  "customClass": "mb-4",
                  "input": true
                }
              ]
            }
          ]
        },
        {
          "type": "columns",
          "key": "loanDetailsRow3",
          "label": "",
          "hideLabel": true,
          "columns": [
            {
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "components": [
                {
                  "type": "datetime",
                  "key": "start_date",
                  "label": "Start Date",
                  "placeholder": "Select start date",
                  "format": "dd-MM-yyyy",
                  "enableTime": false,
                  "customClass": "mb-4",
                  "input": true,
                  "widget": {
                    "type": "calendar",
                    "displayInTimezone": "viewer",
                    "locale": "en",
                    "useLocaleSettings": false,
                    "allowInput": true,
                    "mode": "single",
                    "enableTime": false,
                    "noCalendar": false,
                    "format": "dd-MM-yyyy",
                    "hourIncrement": 1,
                    "minuteIncrement": 5,
                    "time_24hr": false,
                    "minDate": null,
                    "disabledDates": "",
                    "maxDate": null
                  }
                }
              ]
            },
            {
              "width": 6,
              "offset": 0,
              "push": 0,
              "pull": 0,
              "components": [
                {
                  "type": "datetime",
                  "key": "custom_defered_date",
                  "label": "Deferment Date",
                  "placeholder": "Select deferment date",
                  "format": "dd-MM-yyyy",
                  "enableTime": false,
                  "customClass": "mb-4",
                  "input": true,
                  "widget": {
                    "type": "calendar",
                    "displayInTimezone": "viewer",
                    "locale": "en",
                    "useLocaleSettings": false,
                    "allowInput": true,
                    "mode": "single",
                    "enableTime": false,
                    "noCalendar": false,
                    "format": "dd-MM-yyyy",
                    "hourIncrement": 1,
                    "minuteIncrement": 5,
                    "time_24hr": false,
                    "minDate": null,
                    "disabledDates": "",
                    "maxDate": null
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
