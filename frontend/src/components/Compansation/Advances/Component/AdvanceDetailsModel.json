{
    "title": "Advance Details",
    "name": "advanceDetails",
    "path": "advance-details",
    "display": "form",
    "components": [
      {
        "type": "panel",
        "key": "readOnlyPanel",
        "label": "Employee Info",
        "hideLabel": true,
        "customClass": "mb-2",
        "components": [
          {
            "type": "columns",
            "key": "employeeColumns",
            "label": "",
            "hideLabel": true,
            "columns": [
              {
                "width": 6,
                "offset": 0,
                "push": 0,
                "pull": 0,
                "components": [
                  {
                    "type": "textfield",
                    "key": "employee_name",
                    "label": "Employee",
                    "disabled": true,
                    "customClass": "mb-4",
                    "input": true
                  }
                ]
              },
              {
                "width": 6,
                "offset": 0,
                "push": 0,
                "pull": 0,
                "components": [
                  {
                    "type": "textfield",
                    "key": "custom_advance_type",
                    "label": "Advance Type",
                    "disabled": true,
                    "customClass": "mb-4",
                    "input": true
                  }
                ]
              }
            ]
          }
        ]
      },
  
      {
        "type": "panel",
        "key": "editableFieldsPanel",
        "label": "Advance Details",
        "hideLabel": true,
        "customClass": "mb-2",
        "components": [
          {
            "type": "columns",
            "key": "editableColumns1",
            "label": "",
            "hideLabel": true,
            "columns": [
              {
                "width": 6,
                "offset": 0,
                "push": 0,
                "pull": 0,
                "components": [
                  {
                    "type": "currency",
                    "key": "advance_amount",
                    "label": "Advance Amount",
                    "placeholder": "0.00",
                    "currency": "INR",
                    "validate": { "min": 1 },
                    "customClass": "mb-4",
                    "input": true
                  }
                ]
              },
              {
                "width": 6,
                "offset": 0,
                "push": 0,
                "pull": 0,
                "components": [
                  {
                    "type": "textarea",
                    "key": "purpose",
                    "label": "Purpose",
                    "placeholder": "Describe the purpose of advance",
                    "rows": 2,
                    "customClass": "mb-4",
                    "input": true
                  }
                ]
              }
            ]
          },
          {
            "type": "columns",
            "key": "editableColumns2",
            "label": "",
            "hideLabel": true,
            "columns": [
              {
                "width": 6,
                "offset": 0,
                "push": 0,
                "pull": 0,
                "components": [
                  {
                    "type": "datetime",
                    "key": "custom_repayment_start_date",
                    "label": "Start Date",
                    "placeholder": "Select start date",
                    "format": "yyyy-MM-dd",
                    "enableTime": false,
                    "customClass": "mb-4",
                    "input": true,
                    "widget": {
                      "type": "calendar",
                      "displayInTimezone": "viewer",
                      "locale": "en",
                      "useLocaleSettings": false,
                      "allowInput": true,
                      "mode": "single",
                      "enableTime": false,
                      "noCalendar": false,
                      "format": "yyyy-MM-dd",
                      "hourIncrement": 1,
                      "minuteIncrement": 5,
                      "time_24hr": false,
                      "minDate": null,
                      "disabledDates": "",
                      "maxDate": null
                    }
                  }
                ]
              },
              {
                "width": 6,
                "offset": 0,
                "push": 0,
                "pull": 0,
                "components": [
                  {
                    "type": "datetime",
                    "key": "posting_date",
                    "label": "Posting Date",
                    "placeholder": "Select posting date",
                    "format": "dd-MM-yyyy",
                    "enableTime": false,
                    "customClass": "mb-4",
                    "input": true,
                    "widget": {
                      "type": "calendar",
                      "displayInTimezone": "viewer",
                      "locale": "en",
                      "useLocaleSettings": false,
                      "allowInput": true,
                      "mode": "single",
                      "enableTime": false,
                      "noCalendar": false,
                      "format": "dd-MM-yyyy",
                      "hourIncrement": 1,
                      "minuteIncrement": 5,
                      "time_24hr": false,
                      "minDate": null,
                      "disabledDates": "",
                      "maxDate": null
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
  
      {
        "type": "panel",
        "key": "commentPanel",
        "label": "Comment / Reason",
        "hideLabel": false,
        "customClass": "mb-4",
        "components": [
          {
            "type": "textarea",
            "key": "action_comment",
            "label": "Comment",
            "placeholder": "Enter approval comment or rejection reason (required)...",
            "rows": 4,
            "validate": {
              "required": false
            },
            "customClass": "mb-2",
            "input": true,
            "description": "A comment is required before approving or rejecting."
          }
        ]
      },
  
      {
        "type": "panel",
        "key": "hiddenFieldsPanel",
        "label": "Hidden Fields",
        "hideLabel": true,
        "hidden": true,
        "components": [
          {
            "type": "hidden",
            "key": "status",
            "label": "Status",
            "input": true
          },
          {
            "type": "hidden",
            "key": "docname",
            "label": "Document Name",
            "input": true
          },
          {
            "type": "hidden",
            "key": "reference_doctype",
            "label": "Reference Doctype",
            "input": true,
            "defaultValue": "Employee Advance"
          },
          {
            "type": "hidden",
            "key": "selected_action",
            "label": "Selected Action",
            "input": true
          },
          {
            "type": "hidden",
            "key": "todo_id",
            "label": "Todo ID",
            "input": true
          },
          {
            "type": "hidden",
            "key": "comment_email",
            "label": "Comment Email",
            "input": true
          }
        ]
      }
  
    ]
  }