{
  "title": "Salary Structure Assignment",
  "name": "salaryStructureAssignment",
  "path": "salary-structure-assignment",
  "display": "form",
  "components": [
    {
      "type": "panel",
      "key": "detailsPanel",
      "title": "Details",
      "customClass": "py-3 px-5 mb-3 border rounded-lg",
      "components": [
        {
          "type": "columns",
          "key": "detailsRow1",
          "customClass": "mb-2",
          "columns": [
            {
              "width": 4,
              "components": [
                {
                  "type": "select",
                  "key": "employee",
                  "label": "Employee <span style='color:red;margin-left:3px;'>*</span>",
                  "errorLabel": "Employee",
                  "placeholder": "Select Employee",
                  "input": true,
                  "dataSrc": "url",
                  "data": {
                    "url": "/api/method/recruitment.api.job_requisition.get_link_field_options?doctype=Employee",
                    "headers": [{ "key": "Accept", "value": "application/json" }]
                  },
                  "selectValues": "message.results",
                  "valueProperty": "id",
                  "template": "<span>{{ item.label }} <span style='color:#7f8c8d'>({{ item.id }})</span></span>",
                  "lazyLoad": true,
                  "limit": 20,
                  "validate": { "required": true },
                  "customClass": "w-full"
                }
              ]
            },
            {
              "width": 4,
              "components": [
                {
                  "type": "select",
                  "key": "salary_structure",
                  "label": "Salary Structure <span style='color:red;margin-left:3px;'>*</span>",
                  "errorLabel": "Salary Structure",
                  "placeholder": "Select Salary Structure",
                  "input": true,
                  "dataSrc": "url",
                  "data": {
                    "url": "/api/resource/Salary Structure?fields=[\"name\",\"currency\"]&filters=[[\"is_active\",\"=\",\"Yes\"],[\"docstatus\",\"=\",1]]&limit_page_length=0",
                    "headers": [{ "key": "Accept", "value": "application/json" }]
                  },
                  "selectValues": "data",
                  "valueProperty": "name",
                  "template": "<span>{{ item.name }}</span>",
                  "lazyLoad": true,
                  "validate": { "required": true },
                  "customClass": "w-full"
                }
              ]
            },
            {
              "width": 4,
              "components": [
                {
                  "type": "textfield",
                  "key": "company",
                  "label": "Company",
                  "input": true,
                  "disabled": true,
                  "description": "Auto-filled from selected employee",
                  "customClass": "w-full"
                }
              ]
            }
          ]
        },
        {
          "type": "columns",
          "key": "detailsRow2",
          "customClass": "mb-2",
          "columns": [
            {
              "width": 4,
              "components": [
                {
                  "type": "textfield",
                  "key": "employee_name",
                  "label": "Employee Name",
                  "input": true,
                  "disabled": true,
                  "customClass": "w-full"
                }
              ]
            },
            {
              "width": 4,
              "components": [
                {
                  "type": "datetime",
                  "key": "from_date",
                  "label": "From Date <span style='color:red;margin-left:3px;'>*</span>",
                  "format": "yyyy-MM-dd",
                  "enableTime": false,
                  "enableDate": true,
                  "validate": { "required": true },
                  "customClass": "w-full"
                }
              ]
            }
          ]
        },
        {
          "type": "columns",
          "key": "detailsRow3",
          "customClass": "mb-2",
          "columns": [
            {
              "width": 4,
              "components": [
                {
                  "type": "textfield",
                  "key": "designation",
                  "label": "Designation",
                  "input": true,
                  "disabled": true,
                  "description": "Auto-filled from selected employee",
                  "customClass": "w-full"
                }
              ]
            },
            {
              "width": 4,
              "components": [
                {
                  "type": "select",
                  "key": "income_tax_slab",
                  "label": "Income Tax Slab",
                  "placeholder": "Select Income Tax Slab",
                  "input": true,
                  "dataSrc": "url",
                  "data": {
                    "url": "/api/resource/Income Tax Slab?fields=[\"name\"]&filters=[[\"disabled\",\"=\",0]]&limit_page_length=0",
                    "headers": [{ "key": "Accept", "value": "application/json" }]
                  },
                  "selectValues": "data",
                  "valueProperty": "name",
                  "template": "<span>{{ item.name }}</span>",
                  "customClass": "w-full"
                }
              ]
            },
            {
              "width": 4,
              "components": [
                {
                  "type": "textfield",
                  "key": "currency",
                  "label": "Currency",
                  "input": true,
                  "disabled": true,
                  "description": "Auto-filled from selected salary structure",
                  "customClass": "w-full"
                }
              ]
            }
          ]
        },
        {
          "type": "columns",
          "key": "detailsRow4",
          "customClass": "mb-2",
          "columns": [
            {
              "width": 4,
              "components": [
                {
                  "type": "textfield",
                  "key": "grade",
                  "label": "Grade",
                  "input": true,
                  "disabled": true,
                  "description": "Auto-filled from selected employee",
                  "customClass": "w-full"
                }
              ]
            },
            {
              "width": 4,
              "components": [
                {
                  "type": "select",
                  "key": "custom_payroll_period",
                  "label": "Payroll Period <span style='color:red;margin-left:3px;'>*</span>",
                  "errorLabel": "Payroll Period",
                  "placeholder": "Select Payroll Period",
                  "input": true,
                  "dataSrc": "url",
                  "data": {
                    "url": "/api/resource/Payroll Period?fields=[\"name\"]&limit_page_length=0",
                    "headers": [{ "key": "Accept", "value": "application/json" }]
                  },
                  "selectValues": "data",
                  "valueProperty": "name",
                  "template": "<span>{{ item.name }}</span>",
                  "validate": { "required": true },
                  "customClass": "w-full"
                }
              ]
            },
            {
              "width": 4,
              "components": [
                {
                  "type": "datetime",
                  "key": "custom_date_of_joining",
                  "label": "Date Of Joining",
                  "format": "yyyy-MM-dd",
                  "enableTime": false,
                  "disabled": true,
                  "customClass": "w-full"
                }
              ]
            }
          ]
        },
        {
          "type": "textfield",
          "key": "custom_employment_type",
          "label": "Employee Type",
          "input": true,
          "disabled": true,
          "description": "Auto-filled from selected employee",
          "customClass": "w-full md:w-1/3"
        }
      ]
    },
    {
      "type": "panel",
