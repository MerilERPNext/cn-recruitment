{
    "title": "HRA Exemption Request",
    "name": "hraExemptionRequest",
    "path": "hra-exemption-request",
    "display": "form",
    "components": [
        {
            "label": "House Rent Allowance (Exempt u/s 10(13A))",
            "key": "hraExemptionPanel",
            "type": "panel",
            "title": "House Rent Allowance (Exempt u/s 10(13A))",
            "hideLabel": true,
            "customClass": "bg-white rounded-lg",
            "components": [
                {
                    "label": "Columns",
                    "columns": [
                        {
                            "components": [
                                {
                                    "label": "Monthly Rental",
                                    "errorLabel": "Monthly Rental",
                                    "key": "monthly_hra",
                                    "type": "number",
                                    "input": true,
                                    "placeholder": "0",
                                    "validate": {
                                        "required": false
                                    },
                                    "customClass": "mb-4"
                                }
                            ],
                            "width": 4,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "sm": 12,
                            "md": 4,
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "From",
                                    "errorLabel": "From",
                                    "key": "start_date",
                                    "type": "datetime",
                                    "input": true,
                                    "enableTime": false,
                                    "widget": {
                                        "type": "calendar",
                                        "displayInTimezone": "viewer",
                                        "locale": "en",
                                        "format": "dd-MM-yyyy"
                                    },
                                    "format": "dd-MM-yyyy",
                                    "displayInTimezone": "viewer",
                                    "useLocaleSettings": false,
                                    "allowInput": true,
                                    "placeholder": "Select From Date",
                                    "validate": {
                                        "required": false
                                    },
                                    "customClass": "mb-4"
                                }
                            ],
                            "width": 4,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "sm": 12,
                            "md": 4,
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "To",
                                    "errorLabel": "To",
                                    "key": "end_date",
                                    "type": "datetime",
                                    "input": true,
                                    "enableTime": false,
                                    "widget": {
                                        "type": "calendar",
                                        "displayInTimezone": "viewer",
                                        "locale": "en",
                                        "format": "dd-MM-yyyy"
                                    },
                                    "format": "dd-MM-yyyy",
                                    "displayInTimezone": "viewer",
                                    "useLocaleSettings": false,
                                    "allowInput": true,
                                    "placeholder": "Select From Date",
                                    "validate": {
                                        "required": false
                                    },
                                    "customClass": "mb-4"
                                }
                            ],
                            "width": 4,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "sm": 12,
                            "md": 4,
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Owner name",
                                    "errorLabel": "Owner name",
                                    "key": "owner_name",
                                    "type": "textfield",
                                    "input": true,
                                    "placeholder": "Enter Owner name",
                                    "validate": {
                                        "required": false
                                    },
                                    "customClass": "mb-4"
                                }
                            ],
                            "width": 4,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "sm": 12,
                            "md": 4,
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "PAN",
                                    "errorLabel": "PAN",
                                    "key": "pan",
                                    "type": "textfield",
                                    "input": true,
                                    "placeholder": "Enter PAN",
                                    "validate": {
                                        "required": false,
                                        "custom": "valid = (data.monthly_hra > 8333 && !input) ? 'PAN is required when rent exceeds ₹8333/month.' : true;"
                                    },
                                    "tooltip": "PAN is mandatory if rent is more than ₹8333/month or ₹1,00,000/year.",
                                    "customClass": "mb-4"
                                }
                            ],
                            "width": 4,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "sm": 12,
                            "md": 4,
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Is Metro",
                                    "errorLabel": "Is Metro",
                                    "key": "rented_in_metro_city",
                                    "type": "select",
                                    "input": true,
                                    "data": {
                                        "values": [
                                            {
                                                "label": "Non-Metro",
                                                "value": "0"
                                            },
                                            {
                                                "label": "Metro",
                                                "value": "1"
                                            }
                                        ]
                                    },
                                    "defaultValue": "0",
                                    "validate": {
                                        "required": false
                                    },
                                    "customClass": "mb-4"
                                }
                            ],
                            "width": 4,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "sm": 12,
                            "md": 4,
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Address",
                                    "errorLabel": "Address",
                                    "key": "address_line1",
                                    "type": "textfield",
                                    "input": true,
                                    "placeholder": "Enter Address",
                                    "validate": {
                                        "required": false
                                    },
                                    "customClass": "mb-4"
                                }
                            ],
                            "width": 6,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "sm": 12,
                            "md": 6,
                            "currentWidth": 6
                        },
                        {
                            "components": [
                                {
                                    "label": "Attachments",
                                    "key": "attachments",
                                    "type": "file",
                                    "input": true,
                                    "multiple": false,
                                    "storage": "customfiles",
                                    "fileReader": false,
                                    "privateDownload": false,
                                    "filePattern": ".pdf,.doc,.docx,.jpg,.jpeg,.png",
                                    "tooltip": "Upload supporting documents.",
                                    "validate": {
                                        "required": false
                                    },
                                    "customClass": "mb-4"
                                }
                            ],
                            "width": 6,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "sm": 12,
                            "md": 6,
                            "currentWidth": 6
                        }
                    ],
                    "key": "columns",
                    "type": "columns",
                    "input": false,
                    "tableView": false
                }
            ]
        }
    ]
}